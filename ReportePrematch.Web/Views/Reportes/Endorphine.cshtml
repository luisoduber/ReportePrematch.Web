@{
    Layout = "_Layout";
}

<style>
.agent-block { margin-bottom: 2rem; }
.agent-block-header {
    display: flex; align-items: center; gap: .6rem;
    font-size: 1rem; font-weight: 700; letter-spacing: .04em;
    color: #48CAE4; margin-bottom: .6rem;
    padding-bottom: .35rem;
    border-bottom: 1px solid rgba(72,202,228,.25);
}
.agent-block-header i { font-size: 1.1rem; }

.quick-metrics-bar { display:flex; gap:.5rem; flex-wrap:wrap; }
.metric-card { flex:1; min-width:110px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:.5rem .75rem; text-align:center; }
@@media (max-width:768px) { .metric-card { min-width:80px; flex:1 1 80px; padding:.45rem .55rem; } }
@@media (max-width:430px) { .metric-card { min-width:68px; flex:1 1 68px; padding:.38rem .45rem; } .metric-value { font-size:.88rem; } }
.metric-label  { font-size:.62rem; color:rgba(255,255,255,0.5); letter-spacing:.5px; text-transform:uppercase; margin-bottom:.25rem; }
.metric-value  { font-size:1rem; font-weight:700; }
.metric-blue   { color:#48CAE4; }
.metric-red    { color:#f87171; }
.metric-green  { color:#4ade80; }
.metric-yellow { color:#facc15; }
.metric-purple { color:#c084fc; }

.section-title {
    font-size:.8rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase;
    color:rgba(255,255,255,.45); margin-bottom:.6rem;
    display:flex; align-items:center; gap:.4rem;
}
</style>

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub">Casino · Endorphine por Agente</div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaInicio" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaFin" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <!-- Resumen General -->
    <div id="metricsBar" class="quick-metrics-bar mt-3" style="display:none;">
        <div class="metric-card"><div class="metric-label">Usuarios</div><div class="metric-value metric-blue" id="metUsuarios">—</div></div>
        <div class="metric-card"><div class="metric-label">Agentes</div><div class="metric-value metric-blue" id="metAgentes">—</div></div>
        <div class="metric-card"><div class="metric-label">Apuestas</div><div class="metric-value metric-blue" id="metApuestas">—</div></div>
        <div class="metric-card"><div class="metric-label">Premios</div><div class="metric-value metric-blue" id="metPremios">—</div></div>
        <div class="metric-card"><div class="metric-label">Total Riesgo</div><div class="metric-value metric-red" id="metRiesgo">—</div></div>
        <div class="metric-card"><div class="metric-label">Total Premio</div><div class="metric-value metric-red" id="metPremio">—</div></div>
        <div class="metric-card"><div class="metric-label">GGR</div><div class="metric-value metric-green" id="metGGR">—</div></div>
        <div class="metric-card"><div class="metric-label">HOLD</div><div class="metric-value metric-yellow" id="metHOLD">—</div></div>
        <div class="metric-card"><div class="metric-label">RTP</div><div class="metric-value metric-yellow" id="metRTP">—</div></div>
        <div class="metric-card"><div class="metric-label">PromoWin</div><div class="metric-value metric-purple" id="metPromoWin">—</div></div>
    </div>


    <!-- Barra exportacion -->
    <div id="exportBar" class="mt-3 d-none d-flex gap-2 flex-wrap">
        <button class="btn-glass btn-primary" onclick="exportExcel()">
            <i class="ti ti-file-spreadsheet"></i> Excel completo
        </button>
        <button class="btn-glass" style="border-color:rgba(255,100,100,.5);color:#f87171;" onclick="exportPDF()">
            <i class="ti ti-file-type-pdf"></i> PDF por agente
        </button>
    </div>

    <!-- Bloques por agente -->
    <div class="mt-4" id="agentBlocksWrap" style="display:none;">
        <div class="section-title"><i class="ti ti-users"></i> Detalle por Agente</div>
        <div id="agentBlocks"></div>
    </div>
</section>

@section Scripts {
<script>
const esAdmin           = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession     = '@ViewBag.Agente';
const urlReporte        = '@Url.Action("GetEndorphine","Reportes")';
const urlResumenGeneral = '@Url.Action("GetEndorphineResumenGeneral","Reportes")';
let lastData = [];
let dtInstances = [];

function fmt(v) {
    return parseFloat(v || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function fmtFecha(val) {
    if (!val) return '—';
    var s = val.toString().trim();
    var partes = s.split(/[T ]/);
    var fechaParte = partes[0] || s;
    var hora = partes[1] ? partes[1].substring(0, 5) : '';
    if (/^\d{4}-\d{2}-\d{2}$/.test(fechaParte)) {
        var fp = fechaParte.split('-');
        fechaParte = fp[2] + '/' + fp[1] + '/' + fp[0];
    }
    return hora ? fechaParte + ' ' + hora : fechaParte;
}
function card(label, value, cls) {
    return '<div class="metric-card">'
        + '<div class="metric-label">' + label + '</div>'
        + '<div class="metric-value ' + cls + '">' + value + '</div>'
        + '</div>';
}

function limpiarBloques() {
    dtInstances.forEach(function(dt){ try { dt.destroy(); } catch(e){} });
    dtInstances = [];
    document.getElementById('agentBlocks').innerHTML = '';
    document.getElementById('agentBlocksWrap').style.display = 'none';
    lastData = []; document.getElementById('exportBar').classList.add('d-none');
}

function limpiarResumenGeneral() {
    ['metUsuarios','metAgentes','metApuestas','metPremios','metRiesgo',
     'metPremio','metGGR','metHOLD','metRTP','metPromoWin'].forEach(function(id) {
        document.getElementById(id).textContent = '—';
    });
    document.getElementById('metricsBar').style.display = 'none';
}

/* ── resumen general ──────────────────────────────────────────────────── */
function cargarResumenGeneral(fechaInicio, fechaFin, agente) {
    $.post(urlResumenGeneral, { fechaInicio, fechaFin, agente })
        .done(function(data) {
            var r = Array.isArray(data) ? data[0] : data;
            if (!r) { limpiarResumenGeneral(); return; }
            document.getElementById('metUsuarios').textContent = (r.totalUsuarios || 0).toLocaleString('es-VE');
            document.getElementById('metAgentes').textContent  = (r.totalAgentes  || 0).toLocaleString('es-VE');
            document.getElementById('metApuestas').textContent = (r.totalApuestas  || 0).toLocaleString('es-VE');
            document.getElementById('metPremios').textContent  = (r.totalPremios   || 0).toLocaleString('es-VE');
            document.getElementById('metRiesgo').textContent   = fmt(r.totalRiesgo_Bet);
            document.getElementById('metPremio').textContent   = fmt(r.totalPremio_Win);
            document.getElementById('metGGR').textContent      = fmt(r.ggR_Total  || r.gGR_Total  || r.ggr_Total  || 0);
            document.getElementById('metHOLD').textContent     = fmt(r.holD_Porcentaje || r.hOLD_Porcentaje || r.hold_Porcentaje || 0);
            document.getElementById('metRTP').textContent      = fmt(r.rtP_Porcentaje  || r.rTP_Porcentaje  || r.rtp_Porcentaje  || 0);
            document.getElementById('metPromoWin').textContent = fmt(r.promoWin_Total  || 0);
            document.getElementById('metricsBar').style.display = 'flex';
        });
}

/* ── render bloque por agente ─────────────────────────────────────────── */
function renderBloqueAgente(agente, rows, idx) {
    var totAp = 0, totPr = 0, totR = 0, totP = 0, totG = 0, totPromo = 0;
    rows.forEach(function(r) {
        totAp    += (r.cantidadApuestas   || 0);
        totPr    += (r.cantidadPremios    || 0);
        totR     += (r.totalRiesgo_Bet    || 0);
        totP     += (r.totalPremio_Win    || 0);
        totG     += (r.gGR || r.ggr       || 0);
        totPromo += (r.promoWin_Referencia || 0);
    });
    var holdTot = totR > 0 ? (totG / totR * 100) : 0;
    var rtpTot  = totR > 0 ? (totP / totR * 100) : 0;

    var tableId = 'tblEndo_' + idx;
    var block = document.createElement('div');
    block.className = 'agent-block';
    block.innerHTML =
        '<div class="agent-block-header"><i class="ti ti-user"></i>' + agente + '</div>' +
        '<div class="quick-metrics-bar mb-2">' +
            card('Apuestas',    totAp.toLocaleString('es-VE'), 'metric-blue')   +
            card('Premios',     totPr.toLocaleString('es-VE'), 'metric-blue')   +
            card('Total Riesgo',fmt(totR),                     'metric-red')    +
            card('Total Premio',fmt(totP),                     'metric-red')    +
            card('GGR',         fmt(totG),                     totG >= 0 ? 'metric-green' : 'metric-red') +
            card('HOLD %',      fmt(holdTot),                  'metric-yellow') +
            card('RTP %',       fmt(rtpTot),                   'metric-yellow') +
            card('PromoWin',    fmt(totPromo),                 'metric-purple') +
        '</div>' +
        '<div class="table-responsive">' +
        '<table id="' + tableId + '" class="glass-table w-100">' +
        '<thead><tr>' +
            '<th class="text-center">Id Usuario</th>' +
            '<th class="text-center">Usuario</th>' +
            '<th class="text-center">Apuestas</th>' +
            '<th class="text-center">Premios</th>' +
            '<th class="text-center">Total Riesgo</th>' +
            '<th class="text-center">Total Premio</th>' +
            '<th class="text-center">GGR</th>' +
            '<th class="text-center">HOLD %</th>' +
            '<th class="text-center">RTP %</th>' +
            '<th class="text-center">PromoWin</th>' +
            '<th class="text-center">Primera Tx</th>' +
            '<th class="text-center">Última Tx</th>' +
        '</tr></thead><tbody></tbody>' +
        '<tfoot><tr>' +
            '<th class="text-center" colspan="2">TOTAL</th>' +
            '<th class="text-center">' + totAp.toLocaleString('es-VE') + '</th>' +
            '<th class="text-center">' + totPr.toLocaleString('es-VE') + '</th>' +
            '<th class="text-center">' + fmt(totR) + '</th>' +
            '<th class="text-center">' + fmt(totP) + '</th>' +
            '<th style="text-align:center;color:' + (totG >= 0 ? 'var(--av-5,#7FCA8A)' : '#FC8181') + ';font-weight:600;">' + fmt(totG) + '</th>' +
            '<th class="text-center" style="color:#facc15;">' + fmt(holdTot)  + '</th>' +
            '<th class="text-center" style="color:#facc15;">' + fmt(rtpTot)   + '</th>' +
            '<th class="text-center" style="color:#c084fc;">' + fmt(totPromo) + '</th>' +
            '<th class="text-center" colspan="2"></th>' +
        '</tr></tfoot>' +
        '</table></div>';

    document.getElementById('agentBlocks').appendChild(block);

    var dt = $('#' + tableId).DataTable({
        data: rows,
        columns: [
            { data: null, className: 'text-center',
              render: function(r){ return r.idUsuario || '—'; } },
            { data: null, className: 'text-center',
              render: function(r){ return r.usuario   || '—'; } },
            { data: null, className: 'text-center',
              render: function(r){ return (r.cantidadApuestas || 0).toLocaleString('es-VE'); } },
            { data: null, className: 'text-center',
              render: function(r){ return (r.cantidadPremios  || 0).toLocaleString('es-VE'); } },
            { data: null, className: 'text-center col-monto-pos',
              render: function(r){ return fmt(r.totalRiesgo_Bet || 0); } },
            { data: null, className: 'text-center col-monto-neg',
              render: function(r){ return fmt(r.totalPremio_Win || 0); } },
            { data: null, className: 'text-center',
              render: function(r){ return fmt(r.gGR || r.ggr || 0); },
              createdCell: function(td, _d, r) {
                  var g = r.gGR || r.ggr || 0;
                  $(td).addClass(g >= 0 ? 'col-monto-pos' : 'col-monto-neg');
              }},
            { data: null, className: 'text-center',
              render: function(r){ return fmt(r.hOLD_Porcentaje || r.hold_Porcentaje || 0); } },
            { data: null, className: 'text-center',
              render: function(r){ return fmt(r.rTP_Porcentaje  || r.rtp_Porcentaje  || 0); } },
            { data: null, className: 'text-center',
              render: function(r){ return fmt(r.promoWin_Referencia || 0); } },
            { data: null, className: 'text-center',
              render: function(r){ return fmtFecha(r.primeraTransaccion); } },
            { data: null, className: 'text-center',
              render: function(r){ return fmtFecha(r.ultimaTransaccion); } }
        ],
        language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
        pageLength: 25, order: [[6, 'desc']], dom: 'Bfrtip',
        buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm', title: agente }]
    });

    dtInstances.push(dt);
}

/* ── agentes ──────────────────────────────────────────────────────────── */
function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetEndorphineAgentes","Reportes")')
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, { maxOptions: 2000, create: false, allowEmptyOption: true, placeholder: 'Buscar agente...', searchField: ['text'] });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
        })
        .fail(function(xhr) {
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes (HTTP ' + xhr.status + ').', background: '#002E5C', color: '#fff' });
        });
}

/* ── carga principal ──────────────────────────────────────────────────── */
function cargarReporte() {
    const fechaInicio = document.getElementById('fechaInicio').value;
    const fechaFin    = document.getElementById('fechaFin').value;
    const agenteEl    = document.getElementById('agente');
    const agente      = agenteEl ? (agenteEl.tomselect ? agenteEl.tomselect.getValue() : agenteEl.value) : agenteSession;

    if (!fechaInicio || !fechaFin) {
        Swal.fire({ icon: 'warning', title: 'Fechas requeridas', background: '#002E5C', color: '#fff' });
        return;
    }

    limpiarBloques();
    limpiarResumenGeneral();
    showBusy('Consultando...');

    cargarResumenGeneral(fechaInicio, fechaFin, agente);

    $.post(urlReporte, { fechaInicio, fechaFin, agente })
        .done(function(data) {
            hideBusy();
            if (!data || !data.length) {
                Swal.fire({ icon: 'info', title: 'Sin resultados', background: '#002E5C', color: '#fff' });
                return;
            }

            var grupos = {}, orden = [];
            data.forEach(function(r) {
                var ag = r.agente || '(Sin Agente)';
                if (!grupos[ag]) { grupos[ag] = []; orden.push(ag); }
                grupos[ag].push(r);
            });

            document.getElementById('agentBlocksWrap').style.display = '';
            orden.forEach(function(ag, idx) { renderBloqueAgente(ag, grupos[ag], idx); });
            lastData = data; document.getElementById('exportBar').classList.remove('d-none');
        })
        .fail(function(xhr) {
            hideBusy();
            Swal.fire({ icon: 'error', title: 'Error', text: 'Error HTTP ' + xhr.status + ' al consultar.', background: '#002E5C', color: '#fff' });
        });
}


/* -- Exportacion -------------------------------------------------- */
var EXPORT_CONFIG = {
    reportName: 'Endorphine',
    groupField: function(r){ return r.agente||r.Agente||'(Sin Agente)'; },
    cols: [
        { head: 'Agente', get: function(r){ return r.agente||r.Agente||'(Sin Agente)'; }, type: 'text' },
        { head: 'ID Usuario', get: function(r){ return r.idUsuario||'--'; }, type: 'text' },
        { head: 'Usuario', get: function(r){ return r.usuario||'--'; }, type: 'text' },
        { head: 'Apuestas', get: function(r){ return r.cantidadApuestas||0; }, type: 'int' },
        { head: 'Cant Premios', get: function(r){ return r.cantidadPremios||0; }, type: 'int' },
        { head: 'Riesgo', get: function(r){ return r.totalRiesgo_Bet||0; }, type: 'money' },
        { head: 'Premio', get: function(r){ return r.totalPremio_Win||0; }, type: 'money' },
        { head: 'GGR', get: function(r){ return r.gGR||r.ggr||0; }, type: 'money' },
        { head: 'HOLD%', get: function(r){ return r.hOLD_Porcentaje||r.hold_Porcentaje||0; }, type: 'pct' },
        { head: 'RTP%', get: function(r){ return r.rTP_Porcentaje||r.rtp_Porcentaje||0; }, type: 'pct' },
        { head: 'PromoWin', get: function(r){ return r.promoWin_Referencia||0; }, type: 'money' }
    ]
};
function exportExcel() { ExportHelpers.exportarExcel(lastData, EXPORT_CONFIG); }
function exportPDF() {
    ExportHelpers.exportarPDF(lastData, EXPORT_CONFIG, document.getElementById('fechaInicio').value, document.getElementById('fechaFin').value);
}
$(document).ready(function() {
    cargarAgentes();
});
</script>
}
