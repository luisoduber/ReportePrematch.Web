@{
    Layout = "_Layout";
}

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub">Fantasy Baseball · Resumen</div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <!-- Métricas -->
    <div id="metricsBar" class="quick-metrics-bar mt-3" style="display:none;">
        <div class="metric-card"><div class="metric-label">Total Ventas</div><div class="metric-value metric-blue"  id="metVentas">—</div></div>
        <div class="metric-card"><div class="metric-label">Total Premios</div><div class="metric-value metric-red"   id="metPremios">—</div></div>
        <div class="metric-card"><div class="metric-label">Utilidad</div><div class="metric-value metric-green" id="metUtilidad">—</div></div>
    </div>

    <div class="table-responsive mt-3">
        <table id="@ViewBag.TableId" class="glass-table w-100">
            <thead>
                <tr>
                    <th class="text-center">Agente</th>
                    <th class="text-center">Usuario</th>
                    <th class="text-center">Ventas</th>
                    <th class="text-center">Premios</th>
                    <th class="text-center">Utilidad</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

@section Scripts {
<style>
    .quick-metrics-bar { display:flex; gap:.5rem; flex-wrap:wrap; }
    .metric-card { flex:1; min-width:120px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:.5rem .75rem; text-align:center; }
    @@media (max-width:768px) { .metric-card { min-width:80px; flex:1 1 80px; padding:.45rem .55rem; } }
    @@media (max-width:430px) { .metric-card { min-width:68px; flex:1 1 68px; padding:.38rem .45rem; } .metric-value { font-size:.88rem; } }
    .metric-label { font-size:.65rem; color:rgba(255,255,255,0.5); letter-spacing:.5px; text-transform:uppercase; margin-bottom:.25rem; }
    .metric-value { font-size:1.05rem; font-weight:700; }
    .metric-blue  { color:#48CAE4; }
    .metric-red   { color:#f87171; }
    .metric-green { color:#4ade80; }
</style>
<script>
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';

function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgenciasApi","Reportes")')
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            // Destruir instancia Tom Select previa si existe
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            // Inicializar Tom Select con búsqueda
            new TomSelect(sel, {
                maxOptions: 2000,
                create: false,
                allowEmptyOption: true,
                placeholder: 'Buscar agente...',
                searchField: ['text']
            });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
            console.log('[Agentes] ' + (lista ? lista.length : 0) + ' agentes cargados.');
        })
        .fail(function(xhr) {
            console.error('[Agentes] Error HTTP ' + xhr.status + ' al cargar agentes:', xhr.responseText);
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes (HTTP ' + xhr.status + ').', background: '#002E5C', color: '#fff' });
        });
}

let dt;
function fmt(v){ return parseFloat(v||0).toLocaleString('es-VE',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function parseFmt(v) {
    if (v === null || v === undefined || v === '') return 0;
    return parseFloat(v.toString().replace(/\./g, '').replace(',', '.')) || 0;
}

function cargarReporte(){
    const fechaD=document.getElementById('fechaD').value;
    const fechaH=document.getElementById('fechaH').value;
    const agente=document.getElementById('agente').value||'TODOS';
    if(!fechaD||!fechaH){Swal.fire({icon:'warning',title:'Fechas requeridas',background:'#002E5C',color:'#fff'});return;}
    showBusy('Consultando...');

    $.post('@Url.Action("GetFantasyBsb","Reportes")',{fechaD,fechaH,agente})
        .done(function(data){
            if(!data||!data.length){
                Swal.fire({icon:'info',title:'Sin resultados',background:'#002E5C',color:'#fff'});
                document.getElementById('metricsBar').style.display='none';
                hideBusy();return;
            }

            /* Totales */
            var totV=0, totP=0, totU=0;
            data.forEach(function(r){
                totV += parseFmt(r.ventas   || r.Ventas);
                totP += parseFmt(r.premios  || r.Premios);
                totU += parseFmt(r.utilidad || r.Utilidad);
            });
            document.getElementById('metVentas').textContent  = totV.toLocaleString('es-VE',{minimumFractionDigits:2,maximumFractionDigits:2});
            document.getElementById('metPremios').textContent = totP.toLocaleString('es-VE',{minimumFractionDigits:2,maximumFractionDigits:2});
            var elU = document.getElementById('metUtilidad');
            elU.textContent = totU.toLocaleString('es-VE',{minimumFractionDigits:2,maximumFractionDigits:2});
            elU.className   = 'metric-value ' + (totU >= 0 ? 'metric-green' : 'metric-red');
            document.getElementById('metricsBar').style.display = 'flex';

            if(dt)dt.destroy();
            dt=$('#@ViewBag.TableId').DataTable({
                data,
                columns: [
                    { data: 'agente',   className: 'text-center' },
                    { data: 'usuario',  className: 'text-center' },
                    { data: 'ventas',   className: 'text-center col-monto-pos' },
                    { data: 'premios',  className: 'text-center col-monto-neg' },
                    { data: 'utilidad', className: 'text-center',
                      createdCell: function(td, d) {
                          var n = parseFloat((d || '0').toString().replace(/\./g,'').replace(',','.'));
                          $(td).addClass(n < 0 ? 'col-monto-neg' : 'col-monto-pos');
                      }
                    }
                ],
                language:{url:'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'},
                pageLength:25,order:[[0,'asc']],dom:'Bfrtip',
                buttons:[{extend:'excelHtml5',text:'<i class="ti ti-file-spreadsheet"></i> Excel',className:'btn-glass btn-primary btn-sm'}]
            });
            hideBusy();
        }).fail(function(){Swal.fire({icon:'error',title:'Error',background:'#002E5C',color:'#fff'});hideBusy();});
}
$(document).ready(function () {
    cargarAgentes();
    if (!esAdmin) { cargarReporte(); }
});
</script>
}
