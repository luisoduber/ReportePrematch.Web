@{
    Layout = "_Layout";
}

<style>
.canal-toggle {
    display: flex; border-radius: 8px; overflow: hidden;
    border: 1px solid rgba(255,255,255,0.15);
}
.canal-toggle .toggle-btn {
    flex: 1; padding: 6px 14px;
    background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.6);
    border: none; cursor: pointer; font-size: 0.8rem;
    transition: background 0.2s, color 0.2s; white-space: nowrap;
}
.canal-toggle .toggle-btn:first-child { border-right: 1px solid rgba(255,255,255,0.1); }
.canal-toggle .toggle-btn.active { background: var(--sa-5, #0077B6); color: #fff; font-weight: 600; }
.canal-toggle .toggle-btn:hover:not(.active) { background: rgba(255,255,255,0.12); color: #fff; }

.agent-block { margin-bottom: 2rem; }
.agent-block-header {
    display: flex; align-items: center; gap: .6rem;
    font-size: 1rem; font-weight: 700; letter-spacing: .04em;
    color: #48CAE4; margin-bottom: .6rem;
    padding-bottom: .35rem;
    border-bottom: 1px solid rgba(72,202,228,.25);
}
.agent-block-header i { font-size: 1.1rem; }

.quick-metrics-bar { display: flex; gap: .5rem; flex-wrap: wrap; }
.metric-card {
    flex: 1; min-width: 110px;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px; padding: .5rem .75rem; text-align: center;
}
@@media (max-width:768px) { .metric-card { min-width: 80px; flex: 1 1 80px; padding: .45rem .55rem; } }
@@media (max-width:430px) { .metric-card { min-width: 68px; flex: 1 1 68px; padding: .38rem .45rem; } .metric-value { font-size: .88rem; } }
.metric-label { font-size: .62rem; color: rgba(255,255,255,0.5); letter-spacing: .5px; text-transform: uppercase; margin-bottom: .25rem; }
.metric-value { font-size: 1rem; font-weight: 700; }
.metric-blue  { color: #48CAE4; }
.metric-red   { color: #f87171; }
.metric-green { color: #4ade80; }
</style>

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub" id="subtitulo">Canal Taquilla</div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="field-label">Fecha</label>
                <input type="date" id="fecha" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-auto">
                <label class="field-label">Canal</label>
                <div class="canal-toggle" id="toggleCanal">
                    <button class="toggle-btn active" data-val="taq" onclick="setCanal('taq',this)">
                        <i class="ti ti-building-store"></i> Taquilla
                    </button>
                    <button class="toggle-btn" data-val="web" onclick="setCanal('web',this)">
                        <i class="ti ti-world"></i> Web
                    </button>
                </div>
            </div>
            <div class="col-md-2">
                <label class="field-label">Estado</label>
                <select id="operacion" class="glass-select">
                    <option value="">Todos</option>
                    <option value="PENDIENTES">Sin Resultado</option>
                    <option value="GANADORES">Ganadores</option>
                    <option value="GANADORES NO PAGADOS">Gan. No Pagados</option>
                    <option value="GANADORES PARCIALES">Gan. Parciales</option>
                    <option value="PERDEDORES">Perdedores</option>
                    <option value="DEVUELTOS">Devueltos</option>
                    <option value="ANULADOS">Anulados</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="field-label">Nro. Ticket</label>
                <input type="number" id="ticket" class="glass-input" placeholder="Opcional (0 = todos)" min="0" value="0" />
            </div>
            <div class="col-md-auto">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>


    <!-- Barra exportacion -->
    <div id="exportBar" class="mt-3 d-none d-flex gap-2 flex-wrap">
        <button class="btn-glass btn-primary" onclick="exportExcel()">
            <i class="ti ti-file-spreadsheet"></i> Excel completo
        </button>
        <button class="btn-glass" style="border-color:rgba(255,100,100,.5);color:#f87171;" onclick="exportPDF()">
            <i class="ti ti-file-type-pdf"></i> PDF por agente
        </button>
    </div>

    <!-- Bloques por agente -->
    <div id="agentBlocks" class="mt-3"></div>
</section>

@section Scripts {
<script>
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';
let canal = 'taq';
let lastData = [];
let dtInstances = [];

const urlMap = {
    'taq': '@Url.Action("GetBusquedaTicketsTaqApi","Reportes")',
    'web': '@Url.Action("GetBusquedaTicketsWebApi","Reportes")'
};

function setCanal(val, btn) {
    canal = val;
    document.querySelectorAll('#toggleCanal .toggle-btn').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById('subtitulo').textContent = val === 'taq' ? 'Canal Taquilla' : 'Canal Web';
}

function fmt(v) {
    return parseFloat(v || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function tipoApLabel(v) {
    var n = parseInt(v || 0);
    return n === 1 ? 'Directa' : n === 4 ? 'Parlay' : n === 6 ? 'Outright' : v || '—';
}

function fmtFecha(v) {
    if (!v) return '—';
    var d = new Date(v);
    if (isNaN(d)) return v;
    var pad = function(n){ return String(n).padStart(2,'0'); };
    return pad(d.getDate())+'/'+pad(d.getMonth()+1)+'/'+d.getFullYear()+' '+pad(d.getHours())+':'+pad(d.getMinutes());
}

function card(label, value, cls) {
    return '<div class="metric-card">'
        + '<div class="metric-label">' + label + '</div>'
        + '<div class="metric-value ' + cls + '">' + value + '</div>'
        + '</div>';
}

function limpiarBloques() {
    dtInstances.forEach(function(dt){ try { dt.destroy(); } catch(e){} });
    dtInstances = [];
    document.getElementById('agentBlocks').innerHTML = '';
    lastData = []; document.getElementById('exportBar').classList.add('d-none');
}

function renderBloqueAgente(agente, rows, idx) {
    var totR = 0, totG = 0, totU = 0;
    rows.forEach(function(r) {
        totR += parseFloat(r.riesgo   || 0);
        totG += parseFloat(r.ganando  || 0);
        totU += parseFloat(r.utilidad || 0);
    });

    var tableId = 'tblBT_' + idx;
    var block = document.createElement('div');
    block.className = 'agent-block';
    block.innerHTML =
        '<div class="agent-block-header"><i class="ti ti-user"></i>' + agente + '</div>' +
        '<div class="quick-metrics-bar mb-2">' +
            card('Total Riesgo',   fmt(totR), 'metric-blue') +
            card('Total Ganando',  fmt(totG), 'metric-red')  +
            card('Utilidad',       fmt(totU), totU >= 0 ? 'metric-green' : 'metric-red') +
        '</div>' +
        '<div class="table-responsive">' +
        '<table id="' + tableId + '" class="glass-table w-100">' +
        '<thead><tr>' +
            '<th style="text-align:center;">Ticket</th>' +
            '<th style="text-align:center;">Usuario</th>' +
            '<th style="text-align:center;">Fecha</th>' +
            '<th style="text-align:center;">Tipo</th>' +
            '<th style="text-align:center;">Estado</th>' +
            '<th>Descripción</th>' +
            '<th style="text-align:center;">Riesgo</th>' +
            '<th style="text-align:center;">Ganando</th>' +
            '<th style="text-align:center;">Utilidad</th>' +
        '</tr></thead><tbody></tbody>' +
        '<tfoot><tr>' +
            '<th colspan="6" style="text-align:center;">TOTAL</th>' +
            '<th style="text-align:center;">' + fmt(totR) + '</th>' +
            '<th style="text-align:center;">' + fmt(totG) + '</th>' +
            '<th style="text-align:center;">' + fmt(totU) + '</th>' +
        '</tr></tfoot>' +
        '</table></div>';

    document.getElementById('agentBlocks').appendChild(block);

    var dt = $('#' + tableId).DataTable({
        data: rows,
        columns: [
            { data: 'ticket',      className: 'text-center', defaultContent: '—' },
            { data: 'usuario',     className: 'text-center', render: function(d){ return d ? d.toUpperCase() : '—'; } },
            { data: 'fecha',       className: 'text-center', defaultContent: '—',
              render: function(d){ return fmtFecha(d); } },
            { data: 'tipoAp',      className: 'text-center', defaultContent: '—',
              render: function(d){ return tipoApLabel(d); } },
            { data: 'operacion',   className: 'text-center', defaultContent: '—' },
            { data: 'descripcion', defaultContent: '—',
              render: function(d){
                  if (!d || !d.length) return '—';
                  return d.map(function(s){ return '<span class="desc-item">■ ' + s + '</span>'; }).join('');
              }
            },
            { data: 'riesgo',   className: 'text-center col-monto-pos',
              createdCell: function(td, d){ $(td).text(fmt(d)); } },
            { data: 'ganando',  className: 'text-center col-monto-neg',
              createdCell: function(td, d){ $(td).text(fmt(d)); } },
            { data: 'utilidad', className: 'text-center',
              createdCell: function(td, d){ var n = parseFloat(d || 0); $(td).text(fmt(d)).addClass(n >= 0 ? 'col-monto-pos' : 'col-monto-neg'); } }
        ],
        language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
        pageLength: 25, order: [[0, 'desc']], dom: 'Bfrtip',
        buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm', title: agente }]
    });

    dtInstances.push(dt);
}

function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgenciasApi","Reportes")')
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, { maxOptions: 2000, create: false, allowEmptyOption: true, placeholder: 'Buscar agente...', searchField: ['text'] });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
        })
        .fail(function() {
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes.', background: '#002E5C', color: '#fff' });
        });
}

function cargarReporte() {
    const fecha     = document.getElementById('fecha').value;
    const agente    = document.getElementById('agente').value;
    const operacion = document.getElementById('operacion').value;
    const ticket    = parseInt(document.getElementById('ticket').value || '0') || 0;

    if (!fecha && ticket === 0) {
        Swal.fire({ icon: 'warning', title: 'Ingrese una Fecha o un Nro. de Ticket', background: '#002E5C', color: '#fff' });
        return;
    }
    if (!agente && ticket === 0) {
        Swal.fire({ icon: 'warning', title: 'Seleccione un Agente o ingrese un Nro. de Ticket', background: '#002E5C', color: '#fff' });
        return;
    }

    limpiarBloques();
    showBusy('Buscando tickets...');

    $.post(urlMap[canal], { fecha, agente, ticket, operacion })
        .done(function(rows) {
            hideBusy();
            if (!rows || !rows.length) {
                Swal.fire({ icon: 'info', title: 'Sin resultados', background: '#002E5C', color: '#fff' });
                return;
            }

            // Agrupar por agente
            var grupos = {};
            var orden  = [];
            rows.forEach(function(r) {
                var ag = r.agente || '(Sin Agente)';
                if (!grupos[ag]) { grupos[ag] = []; orden.push(ag); }
                grupos[ag].push(r);
            });

            orden.forEach(function(ag, idx) {
                renderBloqueAgente(ag, grupos[ag], idx);
            });
            lastData = rows; document.getElementById('exportBar').classList.remove('d-none');
        })
        .fail(function() {
            hideBusy();
            Swal.fire({ icon: 'error', title: 'Error de conexión', background: '#002E5C', color: '#fff' });
        });
}


/* -- Exportacion -------------------------------------------------- */
var EXPORT_CONFIG = {
    reportName: 'Búsqueda Tickets',
    groupField: function(r){ return r.agente||'(Sin Agente)'; },
    cols: [
        { head: 'Agente', get: function(r){ return r.agente||'(Sin Agente)'; }, type: 'text' },
        { head: 'Ticket', get: function(r){ return r.ticket||'--'; }, type: 'text' },
        { head: 'Usuario', get: function(r){ return r.usuario||'--'; }, type: 'text' },
        { head: 'Fecha', get: function(r){ return r.fecha||'--'; }, type: 'text' },
        { head: 'Tipo Ap.', get: function(r){ return r.tipoAp||'--'; }, type: 'text' },
        { head: 'Operación', get: function(r){ return r.operacion||'--'; }, type: 'text' },
        { head: 'Descripción', get: function(r){ return r.descripcion||'--'; }, type: 'text' },
        { head: 'Riesgo', get: function(r){ return r.riesgo||0; }, type: 'money' },
        { head: 'Ganando', get: function(r){ return r.ganando||0; }, type: 'money' },
        { head: 'Utilidad', get: function(r){ return r.utilidad||0; }, type: 'money' }
    ]
};
function exportExcel() { ExportHelpers.exportarExcel(lastData, EXPORT_CONFIG); }
function exportPDF() {
    var f = document.getElementById('fecha').value;
    ExportHelpers.exportarPDF(lastData, EXPORT_CONFIG, f, f);
}
$(document).ready(function() {
    cargarAgentes();
});
</script>
}
