@{
    Layout = "_Layout";
}

<style>
    .canal-toggle { display:inline-flex; border:1px solid rgba(255,255,255,0.25); border-radius:30px; overflow:hidden; }
    .tog-btn { border:none; background:rgba(255,255,255,0.07); color:rgba(255,255,255,0.35); padding:8px 20px; font-size:11px; font-weight:700; letter-spacing:.8px; cursor:pointer; transition:all .25s; white-space:nowrap; }
    .tog-btn.active { background:var(--sa-5,#0077B6); color:#fff; }
    .quick-metrics-bar { display:flex; gap:.5rem; flex-wrap:wrap; }
    .metric-card { flex:1; min-width:120px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:.5rem .75rem; text-align:center; }
    @@media (max-width:768px) { .metric-card { min-width:80px; flex:1 1 80px; padding:.45rem .55rem; } .canal-toggle { width:100%; } .tog-btn { flex:1; text-align:center; } }
    @@media (max-width:430px) { .metric-card { min-width:68px; flex:1 1 68px; padding:.38rem .45rem; } .metric-value { font-size:.88rem; } }
    .metric-label { font-size:.65rem; color:rgba(255,255,255,0.5); letter-spacing:.5px; text-transform:uppercase; margin-bottom:.25rem; }
    .metric-value { font-size:1.05rem; font-weight:700; }
    .metric-blue  { color:#48CAE4; }
    .metric-red   { color:#f87171; }
    .metric-green { color:#4ade80; }
</style>

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub" id="canalSub">Canal Taquilla · Resumen estadístico por Deporte</div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3 d-flex flex-column align-items-center justify-content-end pb-1">
                <label class="field-label mb-1">Canal</label>
                <div class="canal-toggle">
                    <button class="tog-btn active" id="btnCanalTaq" onclick="setCanal('taq')">TAQUILLA</button>
                    <button class="tog-btn"        id="btnCanalWeb" onclick="setCanal('web')">WEB</button>
                </div>
            </div>
            <div class="col-md-2">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <!-- Métricas rápidas -->
    <div id="metricsBar" class="quick-metrics-bar mt-3" style="display:none;">
        <div class="metric-card"><div class="metric-label">Total Ventas</div><div class="metric-value metric-blue"  id="metVentas">—</div></div>
        <div class="metric-card"><div class="metric-label">Total Pagos</div><div class="metric-value metric-red"    id="metPagos">—</div></div>
        <div class="metric-card"><div class="metric-label">Pendientes</div><div class="metric-value metric-blue"   id="metPendientes">—</div></div>
        <div class="metric-card"><div class="metric-label">Utilidad</div><div class="metric-value metric-green"  id="metUtilidad">—</div></div>
    </div>

    <div class="table-responsive mt-3">
        <table id="@ViewBag.TableId" class="glass-table w-100">
            <thead>
                <tr>
                    <th>Deporte</th>
                    <th style="text-align:center;">Ventas</th>
                    <th style="text-align:center;">Pagos</th>
                    <th style="text-align:center;">Pendientes</th>
                    <th style="text-align:center;">Utilidad</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
                <tr>
                    <th style="text-align:center;">TOTAL</th>
                    <th id="totVentas"     style="text-align:center;"></th>
                    <th id="totPagos"      style="text-align:center;"></th>
                    <th id="totPendientes" style="text-align:center;"></th>
                    <th id="totUtilidad"   style="text-align:center;"></th>
                </tr>
            </tfoot>
        </table>
    </div>
</section>

@section Scripts {
<script>
const tableId       = '#@ViewBag.TableId';
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';
const urlTaq        = '@Url.Action("GetEstadisticasTaq","Reportes")';
const urlWeb        = '@Url.Action("GetEstadisticasWeb","Reportes")';
let canal = 'taq';
let dt;

function fmt(v) {
    return parseFloat(v || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function n(v) { return parseFloat(v || 0); }

function setCanal(c) {
    if (canal === c) return;
    canal = c;
    document.getElementById('btnCanalTaq').classList.toggle('active', c === 'taq');
    document.getElementById('btnCanalWeb').classList.toggle('active', c === 'web');
    document.getElementById('canalSub').textContent = c === 'taq'
        ? 'Canal Taquilla · Resumen estadístico por Deporte'
        : 'Canal Web · Resumen estadístico por Deporte';
    if (dt) { dt.destroy(); dt = null; }
    $(tableId + ' tbody').empty();
    $(tableId + ' tfoot th[id]').text('');
    document.getElementById('metricsBar').style.display = 'none';
}

function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgenciasApi","Reportes")')
        .done(function (lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function (a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, {
                maxOptions: 2000, create: false, allowEmptyOption: true,
                placeholder: 'Buscar agente...', searchField: ['text']
            });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
        })
        .fail(function (xhr) {
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes (HTTP ' + xhr.status + ').', background: '#002E5C', color: '#fff' });
        });
}

function cargarReporte() {
    const fechaD = document.getElementById('fechaD').value;
    const fechaH = document.getElementById('fechaH').value;
    const agente = document.getElementById('agente').value || 'TODOS';

    if (!fechaD || !fechaH) {
        Swal.fire({ icon: 'warning', title: 'Fechas requeridas', background: '#002E5C', color: '#fff' });
        return;
    }

    showBusy(canal === 'taq' ? 'Consultando estadísticas taquilla...' : 'Consultando estadísticas web...');

    $.post(canal === 'taq' ? urlTaq : urlWeb, { fechaD, fechaH, agente })
        .done(function (data) {
            hideBusy();
            if (!data || data.length === 0) {
                Swal.fire({ icon: 'info', title: 'Sin resultados', text: 'No hay datos para el período seleccionado.', background: '#002E5C', color: '#fff' });
                return;
            }

            var totV = 0, totP = 0, totPend = 0, totU = 0;
            data.forEach(function (r) {
                totV    += n(r.Ventas     ?? r.ventas     ?? 0);
                totP    += n(r.Pagos      ?? r.pagos      ?? 0);
                totPend += n(r.Pendientes ?? r.pendientes ?? 0);
                totU    += n(r.Utilidad   ?? r.utilidad   ?? 0);
            });

            document.getElementById('metVentas').textContent     = fmt(totV);
            document.getElementById('metPagos').textContent      = fmt(totP);
            document.getElementById('metPendientes').textContent = fmt(totPend);
            var elBM = document.getElementById('metUtilidad');
            elBM.textContent = fmt(totU);
            elBM.className   = 'metric-value ' + (totU >= 0 ? 'metric-green' : 'metric-red');
            document.getElementById('metricsBar').style.display = 'flex';

            if (dt) { dt.destroy(); }
            dt = $(tableId).DataTable({
                data: data,
                columns: [
                    {
                        data: null,
                        render: function (d) { return d.Deporte ?? d.deporte ?? '—'; }
                    },
                    {
                        data: null,
                        className: 'text-center col-monto-pos',
                        render: function (d, type) {
                            var v = n(d.Ventas ?? d.ventas ?? 0);
                            return (type === 'display' || type === 'filter') ? fmt(v) : v;
                        }
                    },
                    {
                        data: null,
                        className: 'text-center col-monto-neg',
                        render: function (d, type) {
                            var v = n(d.Pagos ?? d.pagos ?? 0);
                            return (type === 'display' || type === 'filter') ? fmt(v) : v;
                        }
                    },
                    {
                        data: null,
                        className: 'text-center',
                        render: function (d, type) {
                            var v = n(d.Pendientes ?? d.pendientes ?? 0);
                            return (type === 'display' || type === 'filter') ? fmt(v) : v;
                        }
                    },
                    {
                        data: null,
                        className: 'text-center',
                        createdCell: function (td, _d, row) {
                            var u = n(row.Utilidad ?? row.utilidad ?? 0);
                            $(td).text(fmt(u));
                            td.style.color      = u >= 0 ? 'var(--av-5, #7FCA8A)' : '#FC8181';
                            td.style.fontWeight = '600';
                        },
                        render: function (d, type) {
                            var u = n(d.Utilidad ?? d.utilidad ?? 0);
                            return (type === 'display' || type === 'filter') ? fmt(u) : u;
                        }
                    }
                ],
                footerCallback: function () {
                    document.getElementById('totVentas').textContent     = fmt(totV);
                    document.getElementById('totPagos').textContent      = fmt(totP);
                    document.getElementById('totPendientes').textContent = fmt(totPend);
                    var elTU = document.getElementById('totUtilidad');
                    elTU.textContent      = fmt(totU);
                    elTU.style.color      = totU >= 0 ? 'var(--av-5, #7FCA8A)' : '#FC8181';
                    elTU.style.fontWeight = '600';
                },
                language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
                pageLength: 25,
                order: [[0, 'asc']],
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="ti ti-file-spreadsheet"></i> Excel',
                        className: 'btn-glass btn-primary btn-sm',
                        exportOptions: { columns: ':visible' }
                    }
                ]
            });
        })
        .fail(function (xhr) {
            hideBusy();
            Swal.fire({ icon: 'error', title: 'Error', text: 'Error HTTP ' + xhr.status + ' al consultar estadísticas.', background: '#002E5C', color: '#fff' });
        });
}

$(document).ready(function () {
    cargarAgentes();
    if (!esAdmin) { cargarReporte(); }
});
</script>
}
