@{
    Layout = "_Layout";
}

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub">Apuestas en vivo · Detalle</div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <!-- Cards de totales -->
    <div class="quick-metrics-bar mt-3" id="metricsBar" style="display:none;">
        <div class="metric-card">
            <div class="metric-label">RTP General</div>
            <div class="metric-value metric-blue" id="metRtpGeneral">—</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Total Riesgo</div>
            <div class="metric-value metric-blue" id="metRiesgo">—</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Total Premios</div>
            <div class="metric-value metric-red" id="metPremios">—</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Total Reversos</div>
            <div class="metric-value metric-blue" id="metReversos">—</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Total GGR</div>
            <div class="metric-value metric-green" id="metGgr">—</div>
        </div>
    </div>

    <div class="table-responsive mt-3">
        <table id="@ViewBag.TableId" class="glass-table w-100">
            <thead>
                <tr>
                    <th style="text-align:center;">Agente</th>
                    <th style="text-align:center;">Usuario</th>
                    <th style="text-align:center;">RTP Agente</th>
                    <th style="text-align:center;">Riesgo</th>
                    <th style="text-align:center;">Premios</th>
                    <th style="text-align:center;">Reversos</th>
                    <th style="text-align:center;">GGR</th>
                    <th style="text-align:center;">RTP Usuario</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
                <tr>
                    <th colspan="3" style="text-align:center;">TOTAL</th>
                    <th id="totRiesgo"   style="text-align:center;"></th>
                    <th id="totPremios"  style="text-align:center;"></th>
                    <th id="totReversos" style="text-align:center;"></th>
                    <th id="totGgr"      style="text-align:center;"></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</section>

@section Scripts {
<script>
const tableId       = '#@ViewBag.TableId';
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';
let dt;

function fmt(val) {
    return parseFloat(val || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function fmtPct(val) {
    return parseFloat(val || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '%';
}

function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgenciasApi","Reportes")')
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, {
                maxOptions: 2000, create: false, allowEmptyOption: true,
                placeholder: 'Buscar agente...', searchField: ['text']
            });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
        })
        .fail(function() {
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes.', background: '#002E5C', color: '#fff' });
        });
}

function cargarReporte() {
    const fechaD = document.getElementById('fechaD').value;
    const fechaH = document.getElementById('fechaH').value;
    const agente = document.getElementById('agente').value || 'TODOS';

    if (!fechaD || !fechaH) {
        Swal.fire({ icon: 'warning', title: 'Fechas requeridas', background: '#002E5C', color: '#fff' });
        return;
    }

    showBusy('Consultando...');

    $.post('@Url.Action("GetVentasDetalladasLive","Reportes")', { fechaD, fechaH, agente })
        .done(function(rows) {
            if (!rows || !rows.length) {
                Swal.fire({ icon: 'info', title: 'Sin resultados', background: '#002E5C', color: '#fff' });
                hideBusy();
                return;
            }

            var totRiesgo = 0, totPremios = 0, totReversos = 0, totGgr = 0, sumRtpGeneral = 0;
            rows.forEach(function(r) {
                totRiesgo      += parseFloat(r.riesgo      || 0);
                totPremios     += parseFloat(r.premios     || 0);
                totReversos    += parseFloat(r.reversos    || 0);
                totGgr         += parseFloat(r.ggr         || 0);
                sumRtpGeneral  += parseFloat(r['rtP_General'] || 0);
            });
            var avgRtpGeneral = rows.length > 0 ? sumRtpGeneral / rows.length : 0;

            document.getElementById('metRtpGeneral').textContent = fmtPct(avgRtpGeneral);
            document.getElementById('metRiesgo').textContent     = fmt(totRiesgo);
            document.getElementById('metPremios').textContent    = fmt(totPremios);
            document.getElementById('metReversos').textContent   = fmt(totReversos);
            document.getElementById('metGgr').textContent        = fmt(totGgr);
            document.getElementById('metricsBar').style.display = 'flex';

            if (dt) { dt.destroy(); dt = null; }
            dt = $(tableId).DataTable({
                data: rows,
                columns: [
                    { data: 'agente',      defaultContent: '—', className: 'text-center' },
                    { data: 'usuario',     defaultContent: '—', className: 'text-center' },
                    { data: 'rtP_Agente',  defaultContent: '0.00%', className: 'text-center', render: function(d){ return fmtPct(d); } },
                    { data: 'riesgo',      defaultContent: '0.00', className: 'text-center', createdCell: function(td, d){ $(td).text(fmt(d)).addClass('col-monto-pos'); } },
                    { data: 'premios',     defaultContent: '0.00', className: 'text-center', createdCell: function(td, d){ $(td).text(fmt(d)).addClass('col-monto-neg'); } },
                    { data: 'reversos',    defaultContent: '0.00', className: 'text-center', createdCell: function(td, d){ $(td).text(fmt(d)).addClass('col-monto-neg'); } },
                    { data: 'ggr',         defaultContent: '0.00', className: 'text-center', createdCell: function(td, d){ $(td).text(fmt(d)).addClass(parseFloat(d) >= 0 ? 'col-monto-pos' : 'col-monto-neg'); } },
                    { data: 'rtP_Usuario', defaultContent: '0.00%', className: 'text-center', render: function(d){ return fmtPct(d); } }
                ],
                footerCallback: function() {
                    document.getElementById('totRiesgo').textContent   = fmt(totRiesgo);
                    document.getElementById('totPremios').textContent  = fmt(totPremios);
                    document.getElementById('totReversos').textContent = fmt(totReversos);
                    document.getElementById('totGgr').textContent      = fmt(totGgr);
                },
                language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
                pageLength: 25, order: [[0, 'asc']], dom: 'Bfrtip',
                buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm' }]
            });

            hideBusy();
        })
        .fail(function() {
            Swal.fire({ icon: 'error', title: 'Error', background: '#002E5C', color: '#fff' });
            hideBusy();
        });
}

$(document).ready(function() {
    cargarAgentes();
    if (!esAdmin) { cargarReporte(); }
});
</script>
}
