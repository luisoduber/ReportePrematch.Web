@{
    Layout = "_Layout";
}

<style>
    .agent-block { margin-bottom: 2rem; }
    .agent-block-header {
        display: flex; align-items: center; gap: .6rem;
        font-size: 1rem; font-weight: 700; letter-spacing: .04em;
        color: #48CAE4; margin-bottom: .6rem;
        padding-bottom: .35rem;
        border-bottom: 1px solid rgba(72,202,228,.25);
    }
    .agent-block-header i { font-size: 1.1rem; }

    .quick-metrics-bar { display:flex; gap:.5rem; flex-wrap:wrap; }
    .metric-card { flex:1; min-width:110px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:.5rem .75rem; text-align:center; }
    @@media (max-width:768px) { .metric-card { min-width:80px; flex:1 1 80px; padding:.45rem .55rem; } }
    @@media (max-width:430px) { .metric-card { min-width:68px; flex:1 1 68px; padding:.38rem .45rem; } .metric-value { font-size:.88rem; } }
    .metric-label { font-size:.62rem; color:rgba(255,255,255,0.5); letter-spacing:.5px; text-transform:uppercase; margin-bottom:.25rem; }
    .metric-value { font-size:1rem; font-weight:700; }
    .metric-blue  { color:#48CAE4; }
    .metric-red   { color:#f87171; }
    .metric-green { color:#4ade80; }
</style>

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub">Ticket por Game ID · Búsqueda directa</div>
        </div>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3">
                <label class="field-label">Game ID</label>
                <input type="text" id="gameId" class="glass-input" placeholder="Ingresa el Game ID" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Tipo Apuesta</label>
                <select id="filtApuesta" class="glass-select">
                    <option value="">Todos</option>
                    <option value="Parlay">Parlay</option>
                    <option value="Directas">Directas</option>
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>


    <!-- Barra exportacion -->
    <div id="exportBar" class="mt-3 d-none d-flex gap-2 flex-wrap">
        <button class="btn-glass btn-primary" onclick="exportExcel()">
            <i class="ti ti-file-spreadsheet"></i> Excel completo
        </button>
        <button class="btn-glass" style="border-color:rgba(255,100,100,.5);color:#f87171;" onclick="exportPDF()">
            <i class="ti ti-file-type-pdf"></i> PDF por agente
        </button>
    </div>

    <!-- Bloques por agente -->
    <div id="agentBlocks" class="mt-3"></div>
</section>

@section Scripts {
<script>
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';
let lastData = [];
let dtInstances = [];

function fmt(v){ return parseFloat(v||0).toLocaleString('es-VE',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function card(label, value, cls) {
    return '<div class="metric-card">'
        + '<div class="metric-label">' + label + '</div>'
        + '<div class="metric-value ' + cls + '">' + value + '</div>'
        + '</div>';
}

function limpiarBloques() {
    dtInstances.forEach(function(dt){ try { dt.destroy(); } catch(e){} });
    dtInstances = [];
    document.getElementById('agentBlocks').innerHTML = '';
    lastData = []; document.getElementById('exportBar').classList.add('d-none');
}

/* ── render bloque por agente ─────────────────────────────────────────── */
function renderBloqueAgente(agente, rows, idx) {
    var totR = 0, totG = 0;
    rows.forEach(function(r){ totR += parseFloat(r.riesgo||0); totG += parseFloat(r.ganancia||0); });

    var tableId = 'tblGID_' + idx;
    var block = document.createElement('div');
    block.className = 'agent-block';
    block.innerHTML =
        '<div class="agent-block-header"><i class="ti ti-user"></i>' + agente + '</div>' +
        '<div class="quick-metrics-bar mb-2">' +
            card('Cant. Tickets',   rows.length.toLocaleString('es-VE'), 'metric-blue')  +
            card('Total Riesgo',    fmt(totR),                           'metric-blue')  +
            card('Total Ganancia',  fmt(totG),                           'metric-red')   +
        '</div>' +
        '<div class="table-responsive">' +
        '<table id="' + tableId + '" class="glass-table w-100" style="min-width:1100px;">' +
        '<thead><tr>' +
            '<th class="text-center">Game ID</th>' +
            '<th class="text-center">Ticket</th>' +
            '<th class="text-center">Tipo Ap.</th>' +
            '<th class="text-center">Usuario</th>' +
            '<th class="text-center">Deporte</th>' +
            '<th class="text-center">Categoría</th>' +
            '<th class="text-center">Logro</th>' +
            '<th class="text-center">Riesgo</th>' +
            '<th class="text-center">Ganancia</th>' +
            '<th class="text-center">Equipo</th>' +
            '<th class="text-center">Est. Ticket</th>' +
            '<th class="text-center">Est. Logro</th>' +
            '<th class="text-center">Fecha Juego</th>' +
            '<th class="text-center">Fecha Ticket</th>' +
        '</tr></thead><tbody></tbody>' +
        '<tfoot><tr>' +
            '<th colspan="7" class="text-center">TOTAL</th>' +
            '<th class="text-center col-monto-pos">' + fmt(totR) + '</th>' +
            '<th class="text-center">' + fmt(totG) + '</th>' +
            '<th colspan="5"></th>' +
        '</tr></tfoot>' +
        '</table></div>';

    document.getElementById('agentBlocks').appendChild(block);

    var dt = $('#' + tableId).DataTable({
        data: rows,
        columns: [
            { data: 'gameID',        className: 'text-center col-ticket',  defaultContent: '—' },
            { data: 'ticket',        className: 'text-center col-ticket',  defaultContent: '—' },
            { data: 'tipoAp',        className: 'text-center',             defaultContent: '—' },
            { data: 'usuario',       className: 'text-center',             render: function(d){ return d ? d.toUpperCase() : '—'; } },
            { data: 'deporte',       className: 'text-center',             defaultContent: '—' },
            { data: 'categoria',     className: 'text-center',             defaultContent: '—' },
            { data: 'logro',         className: 'text-center',             defaultContent: '—' },
            { data: 'riesgo',        className: 'text-center col-monto-pos',
              render: function(d){ return fmt(d); } },
            { data: 'ganancia',      className: 'text-center',             defaultContent: '—',
              createdCell: function(td, d){ var n = parseFloat(d||0); $(td).text(fmt(d)).addClass(n > 0 ? 'col-monto-neg' : 'col-monto-pos'); } },
            { data: 'equipo',        className: 'text-center',             defaultContent: '—' },
            { data: 'estatusTicket', className: 'text-center',             defaultContent: '—' },
            { data: 'estatusLogro',  className: 'text-center',             defaultContent: '—' },
            { data: 'fechaJuego',    className: 'text-center',             defaultContent: '—' },
            { data: 'fechaTicket',   className: 'text-center',             defaultContent: '—' }
        ],
        language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
        pageLength: 100, lengthMenu: [[100, 500, 1000, -1], ['100', '500', '1000', 'Todos']], dom: 'Bfrt<"d-flex justify-content-end align-items-center mt-2"l>', scrollX: true, autoWidth: false,
        buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm', title: agente }]
    });

    dtInstances.push(dt);
}

/* ── agentes ──────────────────────────────────────────────────────────── */
function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgenciasApi","Reportes")')
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, { maxOptions: 2000, create: false, allowEmptyOption: true, placeholder: 'Buscar agente...', searchField: ['text'] });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
        })
        .fail(function(xhr) {
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes (HTTP ' + xhr.status + ').', background: '#002E5C', color: '#fff' });
        });
}

/* ── carga principal ──────────────────────────────────────────────────── */
function cargarReporte() {
    const agente      = document.getElementById('agente').value || 'TODOS';
    const gameId      = document.getElementById('gameId').value;
    const filtApuesta = document.getElementById('filtApuesta').value;

    if (!gameId.trim()) {
        Swal.fire({ icon: 'warning', title: 'Game ID requerido', text: 'Ingresa un Game ID para buscar.', background: '#002E5C', color: '#fff' });
        return;
    }

    limpiarBloques();
    showBusy('Buscando por Game ID...');

    $.post('@Url.Action("GetVentasPorAgenteGameID","Reportes")', { agente, gameId, filtApuesta })
        .done(function(data) {
            hideBusy();
            if (!data || !data.length) {
                Swal.fire({ icon: 'info', title: 'Sin resultados', background: '#002E5C', color: '#fff' });
                return;
            }

            // Agrupar por agente
            var grupos = {};
            var orden  = [];
            data.forEach(function(r) {
                var ag = r.agente || '(Sin Agente)';
                if (!grupos[ag]) { grupos[ag] = []; orden.push(ag); }
                grupos[ag].push(r);
            });

            orden.forEach(function(ag, idx) { renderBloqueAgente(ag, grupos[ag], idx); });
            lastData = data; document.getElementById('exportBar').classList.remove('d-none');
        })
        .fail(function() {
            hideBusy();
            Swal.fire({ icon: 'error', title: 'Error', background: '#002E5C', color: '#fff' });
        });
}


/* -- Exportacion -------------------------------------------------- */
var EXPORT_CONFIG = {
    reportName: 'Ventas Por Agente GameID',
    groupField: function(r){ return r.agente || '(Sin Agente)'; },
    cols: [
        { head: 'Agente',   get: function(r){ return r.agente || '(Sin Agente)'; },  type: 'text' },
        { head: 'Usuario',  get: function(r){ return r.usuario || r.gameId || '--'; }, type: 'text' },
        { head: 'Riesgo',   get: function(r){ return parseFloat(r.riesgo||0); },      type: 'money' },
        { head: 'Ganancia', get: function(r){ return parseFloat(r.ganancia||0); },    type: 'money' }
    ]
};
function exportExcel() { ExportHelpers.exportarExcel(lastData, EXPORT_CONFIG); }
function exportPDF() {
    ExportHelpers.exportarPDF(lastData, EXPORT_CONFIG, '', '');
}
$(document).ready(function() {
    cargarAgentes();
});
</script>
}
