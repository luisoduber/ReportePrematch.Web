@{
    Layout = "_Layout";
}

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub">Ticket por Game ID · Búsqueda directa</div>
        </div>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3">
                <label class="field-label">Game ID</label>
                <input type="text" id="gameId" class="glass-input" placeholder="Ingresa el Game ID" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Tipo Apuesta</label>
                <select id="filtApuesta" class="glass-select">
                    <option value="">Todos</option>
                    <option value="Parlay">Parlay</option>
                    <option value="Directas">Directas</option>
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <div class="table-responsive mt-3">
        <table id="@ViewBag.TableId" class="glass-table w-100">
            <thead>
                <tr>
                    <th style="text-align:center;">Agente</th>
                    <th style="text-align:center;">Game ID</th>
                    <th style="text-align:center;">Ticket</th>
                    <th style="text-align:center;">Tipo Ap.</th>
                    <th style="text-align:center;">Usuario</th>
                    <th style="text-align:center;">Deporte</th>
                    <th style="text-align:center;">Categoría</th>
                    <th style="text-align:center;">Logro</th>
                    <th style="text-align:center;">Riesgo</th>
                    <th style="text-align:center;">Ganancia</th>
                    <th style="text-align:center;">Equipo</th>
                    <th style="text-align:center;">Estatus Ticket</th>
                    <th style="text-align:center;">Estatus Logro</th>
                    <th style="text-align:center;">Fecha Juego</th>
                    <th style="text-align:center;">Fecha Ticket</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

@section Scripts {
<script>
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';

function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgencias","Reportes")', { agente: agenteSession })
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            // Destruir instancia Tom Select previa si existe
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            // Inicializar Tom Select con búsqueda
            new TomSelect(sel, {
                maxOptions: 2000,
                create: false,
                allowEmptyOption: true,
                placeholder: 'Buscar agente...',
                searchField: ['text']
            });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
            console.log('[Agentes] ' + (lista ? lista.length : 0) + ' agentes cargados.');
        })
        .fail(function(xhr) {
            console.error('[Agentes] Error HTTP ' + xhr.status + ' al cargar agentes:', xhr.responseText);
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes (HTTP ' + xhr.status + ').', background: '#002E5C', color: '#fff' });
        });
}

let dt;
function fmt(v){ return parseFloat(v||0).toLocaleString('es-VE',{minimumFractionDigits:2,maximumFractionDigits:2}); }

function cargarReporte(){
    const agente=document.getElementById('agente').value||'TODOS';
    const gameId=document.getElementById('gameId').value;
    const filtApuesta=document.getElementById('filtApuesta').value;
    if(!gameId.trim()){Swal.fire({icon:'warning',title:'Game ID requerido',text:'Ingresa un Game ID para buscar.',background:'#002E5C',color:'#fff'});return;}
    showBusy('Buscando por Game ID...');

    $.post('@Url.Action("GetVentasPorAgenteGameID","Reportes")',{agente,gameId,filtApuesta})
        .done(function(data){
            console.log('[GameID] respuesta controller:', data);
            if(!data||!data.length){Swal.fire({icon:'info',title:'Sin resultados',background:'#002E5C',color:'#fff'});hideBusy();return;}
            if(dt)dt.destroy();
            dt=$('#@ViewBag.TableId').DataTable({
                data,
                columns:[
                    {data:'agente',       title:'Agente',         className:'text-center', defaultContent:'—'},
                    {data:'gameID',       title:'Game ID',        className:'text-center col-ticket'},
                    {data:'ticket',       title:'Ticket',         className:'text-center col-ticket'},
                    {data:'tipoAp',       title:'Tipo Ap.',       className:'text-center', defaultContent:'—'},
                    {data:'usuario',      title:'Usuario',        className:'text-center', defaultContent:'—'},
                    {data:'deporte',      title:'Deporte',        className:'text-center', defaultContent:'—'},
                    {data:'categoria',    title:'Categoría',      className:'text-center', defaultContent:'—'},
                    {data:'logro',        title:'Logro',          className:'text-center', defaultContent:'—'},
                    {data:'riesgo',       title:'Riesgo',         className:'text-center col-monto-pos',
                        render:function(d){return fmt(d);}},
                    {data:'ganancia',     title:'Ganancia',       className:'text-center',
                        createdCell:function(td,d){var n=parseFloat(d||0);$(td).text(fmt(d)).addClass(n>0?'col-monto-neg':'col-monto-pos');}},
                    {data:'equipo',       title:'Equipo',         className:'text-center', defaultContent:'—'},
                    {data:'estatusTicket',title:'Estatus Ticket', className:'text-center', defaultContent:'—'},
                    {data:'estatusLogro', title:'Estatus Logro',  className:'text-center', defaultContent:'—'},
                    {data:'fechaJuego',   title:'Fecha Juego',    className:'text-center', defaultContent:'—'},
                    {data:'fechaTicket',  title:'Fecha Ticket',   className:'text-center', defaultContent:'—'}
                ],
                language:{url:'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'},
                pageLength:25,
                dom:'Bfrtip',
                buttons:[{extend:'excelHtml5',text:'<i class="ti ti-file-spreadsheet"></i> Excel',className:'btn-glass btn-primary btn-sm'}],
                scrollX:true,
                autoWidth:false
            });
            hideBusy();
        }).fail(function(){Swal.fire({icon:'error',title:'Error',background:'#002E5C',color:'#fff'});hideBusy();});
}
$(document).ready(function () {
    cargarAgentes();
});
</script>
}
