@{
    Layout = "_Layout";
}

<style>
.canal-toggle {
    display: flex;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.15);
}
.canal-toggle .toggle-btn {
    flex: 1;
    padding: 6px 14px;
    background: rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.6);
    border: none;
    cursor: pointer;
    font-size: 0.8rem;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
}
.canal-toggle .toggle-btn:first-child { border-right: 1px solid rgba(255,255,255,0.1); }
.canal-toggle .toggle-btn.active {
    background: var(--sa-5, #0077B6);
    color: #fff;
    font-weight: 600;
}
.canal-toggle .toggle-btn:hover:not(.active) {
    background: rgba(255,255,255,0.12);
    color: #fff;
}

.agent-block { margin-bottom: 2rem; }
.agent-block-header {
    display: flex; align-items: center; gap: .6rem;
    font-size: 1rem; font-weight: 700; letter-spacing: .04em;
    color: #48CAE4; margin-bottom: .6rem;
    padding-bottom: .35rem;
    border-bottom: 1px solid rgba(72,202,228,.25);
}
.agent-block-header i { font-size: 1.1rem; }

.quick-metrics-bar { display: flex; gap: .5rem; flex-wrap: wrap; }
.metric-card {
    flex: 1; min-width: 110px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px; padding: .5rem .75rem; text-align: center;
}
@@media (max-width:768px) { .metric-card { min-width: 80px; flex: 1 1 80px; padding: .45rem .55rem; } }
@@media (max-width:430px) { .metric-card { min-width: 68px; flex: 1 1 68px; padding: .38rem .45rem; } .metric-value { font-size: .88rem; } }
.metric-label { font-size: .62rem; color: rgba(255,255,255,0.5); letter-spacing: .5px; text-transform: uppercase; margin-bottom: .25rem; }
.metric-value { font-size: 1rem; font-weight: 700; }
.metric-blue  { color: #48CAE4; }
.metric-red   { color: #f87171; }
.metric-green { color: #4ade80; }
</style>

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub" id="subtitulo">Canal Taquilla · Por Cobrar</div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-auto">
                <label class="field-label">Canal</label>
                <div class="canal-toggle" id="toggleCanal">
                    <button class="toggle-btn active" data-val="taq" onclick="setCanal('taq',this)">
                        <i class="ti ti-building-store"></i> Taquilla
                    </button>
                    <button class="toggle-btn" data-val="web" onclick="setCanal('web',this)">
                        <i class="ti ti-world"></i> Web
                    </button>
                </div>
            </div>
            <div class="col-md-auto">
                <label class="field-label">Estado</label>
                <div class="canal-toggle" id="toggleEstado">
                    <button class="toggle-btn active" data-val="cobrar" onclick="setEstado('cobrar',this)">
                        <i class="ti ti-arrow-bar-down"></i> Por Cobrar
                    </button>
                    <button class="toggle-btn" data-val="pagar" onclick="setEstado('pagar',this)">
                        <i class="ti ti-arrow-bar-up"></i> Por Pagar
                    </button>
                </div>
            </div>
            <div class="col-md-auto">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>


    <!-- Barra exportacion -->
    <div id="exportBar" class="mt-3 d-none d-flex gap-2 flex-wrap">
        <button class="btn-glass btn-primary" onclick="exportExcel()">
            <i class="ti ti-file-spreadsheet"></i> Excel completo
        </button>
        <button class="btn-glass" style="border-color:rgba(255,100,100,.5);color:#f87171;" onclick="exportPDF()">
            <i class="ti ti-file-type-pdf"></i> PDF por agente
        </button>
    </div>

    <!-- Bloques por agente -->
    <div id="agentBlocks" class="mt-3"></div>
</section>

@section Scripts {
<script>
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';
let canal  = 'taq';
let estado = 'cobrar';
let lastData = [];
let dtInstances = [];

const urlMap = {
    'taq-cobrar': '@Url.Action("GetTicketsEnJuegoPorCobrarTaq","Reportes")',
    'taq-pagar':  '@Url.Action("GetTicketsEnJuegoPorPagarTaq","Reportes")',
    'web-cobrar': '@Url.Action("GetTicketsEnJuegoPorCobrarWeb","Reportes")',
    'web-pagar':  '@Url.Action("GetTicketsEnJuegoPorPagarWeb","Reportes")'
};

const subtituloMap = {
    'taq-cobrar': 'Canal Taquilla · Por Cobrar',
    'taq-pagar':  'Canal Taquilla · Por Pagar',
    'web-cobrar': 'Canal Web · Por Cobrar',
    'web-pagar':  'Canal Web · Por Pagar'
};

function setCanal(val, btn) {
    canal = val;
    document.querySelectorAll('#toggleCanal .toggle-btn').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    actualizarSubtitulo();
}

function setEstado(val, btn) {
    estado = val;
    document.querySelectorAll('#toggleEstado .toggle-btn').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    actualizarSubtitulo();
}

function actualizarSubtitulo() {
    document.getElementById('subtitulo').textContent = subtituloMap[canal + '-' + estado] || '';
}

function fmt(val) {
    return parseFloat(val || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function card(label, value, cls) {
    return '<div class="metric-card">'
        + '<div class="metric-label">' + label + '</div>'
        + '<div class="metric-value ' + cls + '">' + value + '</div>'
        + '</div>';
}

function limpiarBloques() {
    dtInstances.forEach(function(dt){ try { dt.destroy(); } catch(e){} });
    dtInstances = [];
    document.getElementById('agentBlocks').innerHTML = '';
    lastData = []; document.getElementById('exportBar').classList.add('d-none');
}

function renderBloqueAgente(agente, rows, idx) {
    var totD = 0, totP = 0, totPr = 0;
    rows.forEach(function(r) {
        totD  += parseFloat(r.directas      || 0);
        totP  += parseFloat(r.parlay         || 0);
        totPr += parseFloat(r.posiblePremio  || 0);
    });

    var tableId = 'tblTEJ_' + idx;
    var block = document.createElement('div');
    block.className = 'agent-block';
    block.innerHTML =
        '<div class="agent-block-header"><i class="ti ti-user"></i>' + agente + '</div>' +
        '<div class="quick-metrics-bar mb-2">' +
            card('Total Directas', fmt(totD),  'metric-blue')  +
            card('Total Parlay',   fmt(totP),  'metric-red')   +
            card('Posible Premio', fmt(totPr), 'metric-green') +
        '</div>' +
        '<div class="table-responsive">' +
        '<table id="' + tableId + '" class="glass-table w-100">' +
        '<thead><tr>' +
            '<th style="text-align:center;">Usuario</th>' +
            '<th style="text-align:center;">Directas</th>' +
            '<th style="text-align:center;">Parlay</th>' +
            '<th style="text-align:center;">Posible Premio</th>' +
        '</tr></thead><tbody></tbody>' +
        '<tfoot><tr>' +
            '<th style="text-align:center;">TOTAL</th>' +
            '<th style="text-align:center;">' + fmt(totD)  + '</th>' +
            '<th style="text-align:center;">' + fmt(totP)  + '</th>' +
            '<th style="text-align:center;">' + fmt(totPr) + '</th>' +
        '</tr></tfoot>' +
        '</table></div>';

    document.getElementById('agentBlocks').appendChild(block);

    var dt = $('#' + tableId).DataTable({
        data: rows,
        columns: [
            { data: 'usuario',       className: 'text-center', render: function(d){ return d ? d.toUpperCase() : '—'; } },
            { data: 'directas',      className: 'text-center', createdCell: function(td, d){ $(td).text(fmt(d)).addClass('col-monto-pos'); } },
            { data: 'parlay',        className: 'text-center', createdCell: function(td, d){ $(td).text(fmt(d)).addClass('col-monto-neg'); } },
            { data: 'posiblePremio', className: 'text-center', createdCell: function(td, d){ $(td).text(fmt(d)).addClass('col-monto-pos'); } }
        ],
        language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
        pageLength: 25, order: [[0, 'asc']], dom: 'Bfrtip',
        buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm', title: agente }]
    });

    dtInstances.push(dt);
}

function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgenciasApi","Reportes")')
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, { maxOptions: 2000, create: false, allowEmptyOption: true, placeholder: 'Buscar agente...', searchField: ['text'] });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
        })
        .fail(function() {
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes.', background: '#002E5C', color: '#fff' });
        });
}

function cargarReporte() {
    const fechaD = document.getElementById('fechaD').value;
    const fechaH = document.getElementById('fechaH').value;
    const agente = document.getElementById('agente').value || 'TODOS';

    if (!fechaD || !fechaH) {
        Swal.fire({ icon: 'warning', title: 'Fechas requeridas', background: '#002E5C', color: '#fff' });
        return;
    }

    limpiarBloques();
    showBusy('Consultando...');

    $.post(urlMap[canal + '-' + estado], { fechaD, fechaH, agente })
        .done(function(rows) {
            hideBusy();
            if (!rows || !rows.length) {
                Swal.fire({ icon: 'info', title: 'Sin resultados', background: '#002E5C', color: '#fff' });
                return;
            }

            // Agrupar por agente
            var grupos = {};
            var orden  = [];
            rows.forEach(function(r) {
                var ag = r.agente || '(Sin Agente)';
                if (!grupos[ag]) { grupos[ag] = []; orden.push(ag); }
                grupos[ag].push(r);
            });

            orden.forEach(function(ag, idx) {
                renderBloqueAgente(ag, grupos[ag], idx);
            });
            lastData = rows; document.getElementById('exportBar').classList.remove('d-none');
        })
        .fail(function() {
            hideBusy();
            Swal.fire({ icon: 'error', title: 'Error de conexión', background: '#002E5C', color: '#fff' });
        });
}


/* -- Exportacion -------------------------------------------------- */
var EXPORT_CONFIG = {
    reportName: 'Tickets en Juego',
    groupField: function(r){ return r.agente||'(Sin Agente)'; },
    cols: [
        { head: 'Agente', get: function(r){ return r.agente||'(Sin Agente)'; }, type: 'text' },
        { head: 'Usuario', get: function(r){ return r.usuario||'--'; }, type: 'text' },
        { head: 'Directas', get: function(r){ return r.directas||0; }, type: 'money' },
        { head: 'Parlay', get: function(r){ return r.parlay||0; }, type: 'money' },
        { head: 'Posible Premio', get: function(r){ return r.posiblePremio||0; }, type: 'money' }
    ]
};
function exportExcel() { ExportHelpers.exportarExcel(lastData, EXPORT_CONFIG); }
function exportPDF() {
    var fd = document.getElementById('fechaD').value;
    var fh = document.getElementById('fechaH').value;
    ExportHelpers.exportarPDF(lastData, EXPORT_CONFIG, fd, fh);
}
$(document).ready(function() {
    cargarAgentes();
    if (!esAdmin) { cargarReporte(); }
});
</script>
}
