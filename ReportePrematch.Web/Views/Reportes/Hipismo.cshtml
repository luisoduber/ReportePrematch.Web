@{
    Layout = "_Layout";
}

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub">Hipismo · Carreras de caballos</div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <div id="tituloAgente" class="mt-3 ms-1" style="font-size:1rem;font-weight:700;color:#7EC8E3;display:none;"></div>

    <div class="table-responsive mt-2">
        <table id="@ViewBag.TableId" class="glass-table w-100">
            <thead>
                <tr>
                    <th class="text-center" style="width:40px;">Detalles</th>
                    <th class="text-center">Usuario</th>
                    <th class="text-center">Ventas</th>
                    <th class="text-center">Premios</th>
                    <th class="text-center">Utilidad</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

<style>
.btn-detalle {
    background: none;
    border: 2px solid #7EC8E3;
    border-radius: 50%;
    color: #7EC8E3;
    width: 26px; height: 26px;
    font-size: 1rem; font-weight: 700;
    line-height: 1; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    transition: background 0.2s, color 0.2s;
}
.btn-detalle:hover { background: #7EC8E3; color: #002E5C; }
.btn-detalle.abierto { background: #7EC8E3; color: #002E5C; }
.child-table-wrap { padding: 10px 20px 14px 40px; }
.child-table {
    width: 100%; border-collapse: collapse;
    font-size: 0.82rem; color: #cde;
}
.child-table thead tr { background: #1a3a5c; }
.child-table th { padding: 6px 10px; text-align: center; font-weight: 600; letter-spacing:.04em; }
.child-table td { padding: 5px 10px; text-align: center; border-bottom: 1px solid rgba(255,255,255,0.06); }
.child-table tr:nth-child(even) td { background: rgba(255,255,255,0.03); }
.child-footer { padding: 4px 10px 0; font-size:0.8rem; color: rgba(255,255,255,0.5); font-style: italic; }
@@media (max-width:768px) {
    .child-table-wrap { padding: 8px 8px 10px 12px; }
    .child-table th, .child-table td { padding: 4px 6px; font-size: 0.75rem; }
}
</style>

@section Scripts {
<script>
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';

function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgencias","Reportes")', { agente: agenteSession })
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, {
                maxOptions: 2000, create: false, allowEmptyOption: true,
                placeholder: 'Buscar agente...', searchField: ['text']
            });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
        })
        .fail(function(xhr) {
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar agentes (HTTP ' + xhr.status + ').', background: '#002E5C', color: '#fff' });
        });
}

let dt;
let _fechaD, _fechaH;
function fmt(v) { return parseFloat(v || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

function buildChildTable(detalles, usuario) {
    if (!detalles || !detalles.length) {
        return '<div class="child-table-wrap"><em style="color:rgba(255,255,255,0.4)">Sin transacciones.</em></div>';
    }
    var rows = detalles.map(function(d) {
        return '<tr>' +
            '<td>' + (d.idTransaccion || d.IdTransaccion || '—') + '</td>' +
            '<td>' + (d.reference    || d.Reference    || '—') + '</td>' +
            '<td>' + fmt(d.monto     || d.Monto)              + '</td>' +
            '<td>' + (d.action       || d.Action       || '—') + '</td>' +
            '<td>' + (d.jugadas || d.Jugadas || '—') + '</td>' +
        '</tr>';
    }).join('');
    return '<div class="child-table-wrap">' +
        '<table class="child-table">' +
            '<thead><tr>' +
                '<th style="text-align:center;">Transaction</th><th style="text-align:center;">Reference</th><th style="text-align:center;">Amount</th><th style="text-align:center;">Action</th><th style="text-align:center;">Plays</th>' +
            '</tr></thead>' +
            '<tbody>' + rows + '</tbody>' +
        '</table>' +
        '<div class="child-footer">Transacciones de: ' + usuario + '</div>' +
    '</div>';
}

function toggleDetalle(btn, rowData) {
    var tr   = $(btn).closest('tr');
    var row  = dt.row(tr);
    var user = rowData.usuario || rowData.Usuario || '';

    if (row.child.isShown()) {
        row.child.hide();
        $(btn).text('+').removeClass('abierto');
        return;
    }

    $(btn).text('…').prop('disabled', true);
    $.post('@Url.Action("GetDetallesHipismo","Reportes")', { fechaD: _fechaD, fechaH: _fechaH, usuario: user })
        .done(function(detalles) {
            row.child(buildChildTable(detalles, user)).show();
            $(btn).text('−').addClass('abierto').prop('disabled', false);
        })
        .fail(function() {
            row.child('<div class="child-table-wrap" style="color:#f88;">Error al cargar detalles.</div>').show();
            $(btn).text('+').prop('disabled', false);
        });
}

function cargarReporte() {
    const fechaD = document.getElementById('fechaD').value;
    const fechaH = document.getElementById('fechaH').value;
    const agente = document.getElementById('agente').value || 'TODOS';
    if (!fechaD || !fechaH) { Swal.fire({ icon: 'warning', title: 'Fechas requeridas', background: '#002E5C', color: '#fff' }); return; }

    _fechaD = fechaD; _fechaH = fechaH;

    const tituloEl = document.getElementById('tituloAgente');
    tituloEl.textContent = agente !== 'TODOS' ? agente.toUpperCase() : '';
    tituloEl.style.display = agente !== 'TODOS' ? '' : 'none';

    showBusy('Consultando...');

    $.post('@Url.Action("GetHipismo","Reportes")', { fechaD, fechaH, agente })
        .done(function(data) {
            if (!data || !data.length) {
                Swal.fire({ icon: 'info', title: 'Sin resultados', background: '#002E5C', color: '#fff' });
                hideBusy(); return;
            }
            if (dt) { dt.destroy(); dt = null; }
            dt = $('#@ViewBag.TableId').DataTable({
                data: data,
                columns: [
                    {
                        data: null,
                        className: 'text-center',
                        orderable: false,
                        render: function() {
                            return '<button class="btn-detalle" title="Ver detalles">+</button>';
                        }
                    },
                    { data: null, className: 'text-center', render: function(d) { return d.usuario || d.Usuario || '—'; } },
                    { data: null, className: 'text-center col-monto-pos', render: function(d) { return fmt(d.ventas || d.Ventas); } },
                    { data: null, className: 'text-center col-monto-neg', render: function(d) { return fmt(d.premios || d.Premios); } },
                    { data: null, className: 'text-center',
                      createdCell: function(td, d) {
                          var n = parseFloat((d.utilidad || d.Utilidad || '0').toString().replace(/\./g,'').replace(',','.'));
                          $(td).addClass(n < 0 ? 'col-monto-neg' : 'col-monto-pos');
                      },
                      render: function(d) { return fmt(d.utilidad || d.Utilidad); }
                    }
                ],
                language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
                pageLength: 50, order: [[1, 'asc']], dom: 'Bfrtip',
                buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm' }]
            });

            // Delegación de evento para el botón +
            $('#@ViewBag.TableId tbody').off('click', '.btn-detalle').on('click', '.btn-detalle', function() {
                var tr      = $(this).closest('tr');
                var rowData = dt.row(tr).data();
                toggleDetalle(this, rowData);
            });

            hideBusy();
        })
        .fail(function() {
            Swal.fire({ icon: 'error', title: 'Error de conexión', background: '#002E5C', color: '#fff' });
            hideBusy();
        });
}

$(document).ready(function() {
    cargarAgentes();
    if (!esAdmin) { cargarReporte(); }
});
</script>
}
