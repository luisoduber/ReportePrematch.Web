@{
    Layout = "_Layout";
}

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub">Canal Web · Usuario: <strong>@ViewBag.Usuario</strong></div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <div class="quick-metrics-bar mt-3" id="metricsBar" style="display:none;">
        <div class="metric-card"><div class="metric-label">Ventas Parlay</div><div class="metric-value metric-blue" id="metVP">—</div></div>
        <div class="metric-card"><div class="metric-label">Ventas Directo</div><div class="metric-value metric-blue" id="metVD">—</div></div>
        <div class="metric-card"><div class="metric-label">Premios Parlay</div><div class="metric-value metric-red" id="metPP">—</div></div>
        <div class="metric-card"><div class="metric-label">Premios Directo</div><div class="metric-value metric-red" id="metPD">—</div></div>
        <div class="metric-card"><div class="metric-label">Balance</div><div class="metric-value metric-green" id="metBal">—</div></div>
    </div>

    <div class="table-responsive mt-3">
        <table id="@ViewBag.TableId" class="glass-table w-100">
            <thead>
                <tr>
                    <th>Agente</th><th>Usuario</th><th>País</th>
                    <th>Venta Par</th><th>Venta Dir</th>
                    <th>Premios Par</th><th>Premios Dir</th><th>Balance</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
                <tr>
                    <th colspan="3">TOTAL</th>
                    <th id="tVP"></th><th id="tVD"></th>
                    <th id="tPP"></th><th id="tPD"></th>
                    <th id="tBal"></th>
                </tr>
            </tfoot>
        </table>
    </div>
</section>

@section Scripts {
<script>
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';

function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgencias","Reportes")', { agente: agenteSession })
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            // Destruir instancia Tom Select previa si existe
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            // Inicializar Tom Select con búsqueda
            new TomSelect(sel, {
                maxOptions: 2000,
                create: false,
                allowEmptyOption: true,
                placeholder: 'Buscar agente...',
                searchField: ['text']
            });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
            console.log('[Agentes] ' + (lista ? lista.length : 0) + ' agentes cargados.');
        })
        .fail(function(xhr) {
            console.error('[Agentes] Error HTTP ' + xhr.status + ' al cargar agentes:', xhr.responseText);
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes (HTTP ' + xhr.status + ').', background: '#002E5C', color: '#fff' });
        });
}

let dt;
function fmt(v) { return parseFloat(v||0).toLocaleString('es-VE',{minimumFractionDigits:2,maximumFractionDigits:2}); }

function cargarReporte() {
    const fechaD = document.getElementById('fechaD').value;
    const fechaH = document.getElementById('fechaH').value;
    const agente  = document.getElementById('agente').value;
    if (!fechaD || !fechaH) { Swal.fire({icon:'warning',title:'Fechas requeridas',background:'#002E5C',color:'#fff'}); return; }
    showBusy('Consultando ventas web...');

    $.post('@Url.Action("GetVentasPorAgenteWeb","Reportes")', {fechaD,fechaH,agente})
        .done(function(data) {
            if (!data || !data.length) { Swal.fire({icon:'info',title:'Sin resultados',background:'#002E5C',color:'#fff'}); hideBusy(); return; }
            let vP=0,vD=0,pP=0,pD=0;
            data.forEach(r=>{ vP+=parseFloat(r.ventaPar||0); vD+=parseFloat(r.ventaDir||0); pP+=parseFloat(r.premiosPar||0); pD+=parseFloat(r.premiosDir||0); });
            document.getElementById('metVP').textContent=fmt(vP);
            document.getElementById('metVD').textContent=fmt(vD);
            document.getElementById('metPP').textContent=fmt(pP);
            document.getElementById('metPD').textContent=fmt(pD);
            const bal=(vP+vD)-(pP+pD);
            document.getElementById('metBal').textContent=fmt(bal);
            document.getElementById('metricsBar').style.display='flex';

            if (dt) dt.destroy();
            dt = $('#@ViewBag.TableId').DataTable({
                data, columns:[
                    {data:'agente'},{data:'usuario'},{data:'pais',defaultContent:'—'},
                    {data:'ventaPar',  render:d=>`<span class="col-monto-pos">${fmt(d)}</span>`},
                    {data:'ventaDir',  render:d=>`<span class="col-monto-pos">${fmt(d)}</span>`},
                    {data:'premiosPar',render:d=>`<span class="col-monto-neg">${fmt(d)}</span>`},
                    {data:'premiosDir',render:d=>`<span class="col-monto-neg">${fmt(d)}</span>`},
                    {data:null,render:r=>{const b=(parseFloat(r.ventaPar||0)+parseFloat(r.ventaDir||0))-(parseFloat(r.premiosPar||0)+parseFloat(r.premiosDir||0));return `<span class="${b>=0?'col-monto-pos':'col-monto-neg'}">${fmt(b)}</span>`;}}
                ],
                footerCallback:function(){
                    document.getElementById('tVP').textContent=fmt(vP);document.getElementById('tVD').textContent=fmt(vD);
                    document.getElementById('tPP').textContent=fmt(pP);document.getElementById('tPD').textContent=fmt(pD);
                    document.getElementById('tBal').textContent=fmt(bal);
                },
                language:{url:'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'},
                pageLength:25, order:[[0,'asc']], dom:'Bfrtip',
                buttons:[{extend:'excelHtml5',text:'<i class="ti ti-file-spreadsheet"></i> Excel',className:'btn-glass btn-primary btn-sm'}]
            });
            hideBusy();
        }).fail(function(){ Swal.fire({icon:'error',title:'Error',background:'#002E5C',color:'#fff'}); hideBusy(); });
}
$(document).ready(function () {
    cargarAgentes();
    if (!esAdmin) { cargarReporte(); }
});
</script>
}
