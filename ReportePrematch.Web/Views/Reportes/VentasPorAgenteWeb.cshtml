@{
    Layout = "_Layout";
}

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub">Canal Web · Usuario: <strong>@ViewBag.Usuario</strong></div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <!-- Métricas rápidas -->
    <div class="quick-metrics-bar mt-3" id="metricsBar" style="display:none;">
        <div class="metric-card"><div class="metric-label">Total Ventas</div><div class="metric-value metric-blue" id="metTV">—</div></div>
        <div class="metric-card"><div class="metric-label">Total Premios</div><div class="metric-value metric-red" id="metTP">—</div></div>
        <div class="metric-card"><div class="metric-label">Pendientes</div><div class="metric-value metric-blue" id="metPen">—</div></div>
        <div class="metric-card"><div class="metric-label">Utilidad</div><div class="metric-value metric-green" id="metUtil">—</div></div>
    </div>

    <style>
        #@ViewBag.TableId thead th {
            text-align: center;
            vertical-align: bottom;
            white-space: normal;
            word-break: break-word;
            max-width: 75px;
            min-width: 65px;
            line-height: 1.3;
            padding: 6px 4px;
        }
        #@ViewBag.TableId thead th.th-usuario {
            max-width: 120px;
            min-width: 90px;
            vertical-align: middle;
            white-space: nowrap;
        }
    </style>

    <div class="table-responsive mt-3">
        <table id="@ViewBag.TableId" class="glass-table w-100">
            <thead>
                <tr>
                    <th class="th-usuario" style="text-align:center;">Usuario</th>
                    <th style="text-align:center;">Ventas Directas</th>
                    <th style="text-align:center;">Ventas Directas Bono</th>
                    <th style="text-align:center;">Ventas Parlay</th>
                    <th style="text-align:center;">Ventas Parlay Bono</th>
                    <th style="text-align:center;">Total Ventas</th>
                    <th style="text-align:center;">Total Ventas Bono</th>
                    <th style="text-align:center;">Premios Directa</th>
                    <th style="text-align:center;">Premios Parlay</th>
                    <th style="text-align:center;">Total Premios</th>
                    <th style="text-align:center;">Total Premios Bono</th>
                    <th style="text-align:center;">Pendientes</th>
                    <th style="text-align:center;">Utilidad</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
                <tr>
                    <th style="text-align:center;">TOTAL</th>
                    <th id="tVD"   style="text-align:center;"></th>
                    <th id="tVDB"  style="text-align:center;"></th>
                    <th id="tVP"   style="text-align:center;"></th>
                    <th id="tVPB"  style="text-align:center;"></th>
                    <th id="tTV"   style="text-align:center;"></th>
                    <th id="tTVB"  style="text-align:center;"></th>
                    <th id="tPD"   style="text-align:center;"></th>
                    <th id="tPP"   style="text-align:center;"></th>
                    <th id="tTP"   style="text-align:center;"></th>
                    <th id="tTPB"  style="text-align:center;"></th>
                    <th id="tPen"  style="text-align:center;"></th>
                    <th id="tUtil" style="text-align:center;"></th>
                </tr>
            </tfoot>
        </table>
    </div>
</section>

@section Scripts {
<script>
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';
let dt;

function fmt(v) { return parseFloat(v||0).toLocaleString('es-VE',{minimumFractionDigits:2,maximumFractionDigits:2}); }

function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgenciasApi","Reportes")')
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, { maxOptions:2000, create:false, allowEmptyOption:true, placeholder:'Buscar agente...', searchField:['text'] });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
            console.log('[Agentes] ' + (lista ? lista.length : 0) + ' agentes cargados.');
        })
        .fail(function(xhr) {
            console.error('[Agentes] Error HTTP ' + xhr.status);
            Swal.fire({ icon:'warning', title:'Aviso', text:'No se pudo cargar la lista de agentes (HTTP '+xhr.status+').', background:'#002E5C', color:'#fff' });
        });
}

function cargarReporte() {
    const fechaD = document.getElementById('fechaD').value;
    const fechaH = document.getElementById('fechaH').value;
    const agente  = document.getElementById('agente').value || 'TODOS';
    if (!fechaD || !fechaH) { Swal.fire({icon:'warning',title:'Fechas requeridas',background:'#002E5C',color:'#fff'}); return; }
    showBusy('Consultando ventas web...');

    $.post('@Url.Action("GetVentasPorAgenteWeb","Reportes")', {fechaD,fechaH,agente})
        .done(function(data) {
            if (!data || !data.length) { Swal.fire({icon:'info',title:'Sin resultados',background:'#002E5C',color:'#fff'}); hideBusy(); return; }

            // Totales
            let totVD=0, totVDB=0, totVP=0, totVPB=0, totTV=0, totTVB=0;
            let totPD=0, totPP=0, totTP=0, totTPB=0, totPen=0, totUtil=0;
            data.forEach(function(r) {
                totVD   += parseFloat(r.ventaDir        || 0);
                totVDB  += parseFloat(r.ventaDirBono    || 0);
                totVP   += parseFloat(r.ventaPar        || 0);
                totVPB  += parseFloat(r.ventaParBono    || 0);
                totTV   += parseFloat(r.totalVentas     || 0);
                totTVB  += parseFloat(r.totalVentasBono || 0);
                totPD   += parseFloat(r.premiosDir      || 0);
                totPP   += parseFloat(r.premiosPar      || 0);
                totTP   += parseFloat(r.totalPremios    || 0);
                totTPB  += parseFloat(r.totalPremiosBono|| 0);
                totPen  += parseFloat(r.pendientes      || 0);
                totUtil += parseFloat(r.utilidad        || 0);
            });

            // Métricas
            document.getElementById('metTV').textContent   = fmt(totTV);
            document.getElementById('metTP').textContent   = fmt(totTP);
            document.getElementById('metPen').textContent  = fmt(totPen);
            document.getElementById('metUtil').textContent = fmt(totUtil);
            document.getElementById('metricsBar').style.display = 'flex';

            if (dt) dt.destroy();
            dt = $('#@ViewBag.TableId').DataTable({
                data: data,
                columns: [
                    { data:'usuario',          defaultContent:'—', className:'text-center' },
                    { data:'ventaDir',         className:'text-center', createdCell:function(td,d){$(td).text(fmt(d)).addClass('col-monto-pos');} },
                    { data:'ventaDirBono',     className:'text-center', createdCell:function(td,d){$(td).text(fmt(d)).addClass('col-monto-pos');} },
                    { data:'ventaPar',         className:'text-center', createdCell:function(td,d){$(td).text(fmt(d)).addClass('col-monto-pos');} },
                    { data:'ventaParBono',     className:'text-center', createdCell:function(td,d){$(td).text(fmt(d)).addClass('col-monto-pos');} },
                    { data:'totalVentas',      className:'text-center', createdCell:function(td,d){$(td).text(fmt(d)).addClass('col-monto-pos');} },
                    { data:'totalVentasBono',  className:'text-center', createdCell:function(td,d){$(td).text(fmt(d)).addClass('col-monto-pos');} },
                    { data:'premiosDir',       className:'text-center', createdCell:function(td,d){$(td).text(fmt(d)).addClass('col-monto-neg');} },
                    { data:'premiosPar',       className:'text-center', createdCell:function(td,d){$(td).text(fmt(d)).addClass('col-monto-neg');} },
                    { data:'totalPremios',     className:'text-center', createdCell:function(td,d){$(td).text(fmt(d)).addClass('col-monto-neg');} },
                    { data:'totalPremiosBono', className:'text-center', createdCell:function(td,d){$(td).text(fmt(d)).addClass('col-monto-neg');} },
                    { data:'pendientes',       className:'text-center', createdCell:function(td,d){$(td).text(fmt(d)).addClass('col-monto-pos');} },
                    {
                        data:'utilidad', className:'text-center',
                        createdCell:function(td,d){ var n=parseFloat(d||0); $(td).text(fmt(d)).addClass(n>=0?'col-monto-pos':'col-monto-neg'); }
                    }
                ],
                footerCallback: function() {
                    document.getElementById('tVD').textContent   = fmt(totVD);
                    document.getElementById('tVDB').textContent  = fmt(totVDB);
                    document.getElementById('tVP').textContent   = fmt(totVP);
                    document.getElementById('tVPB').textContent  = fmt(totVPB);
                    document.getElementById('tTV').textContent   = fmt(totTV);
                    document.getElementById('tTVB').textContent  = fmt(totTVB);
                    document.getElementById('tPD').textContent   = fmt(totPD);
                    document.getElementById('tPP').textContent   = fmt(totPP);
                    document.getElementById('tTP').textContent   = fmt(totTP);
                    document.getElementById('tTPB').textContent  = fmt(totTPB);
                    document.getElementById('tPen').textContent  = fmt(totPen);
                    document.getElementById('tUtil').textContent = fmt(totUtil);
                },
                language: { url:'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
                pageLength: 25, order:[[0,'asc']], dom:'Bfrtip',
                buttons:[{extend:'excelHtml5',text:'<i class="ti ti-file-spreadsheet"></i> Excel',className:'btn-glass btn-primary btn-sm'}]
            });
            hideBusy();
        })
        .fail(function(){ Swal.fire({icon:'error',title:'Error',background:'#002E5C',color:'#fff'}); hideBusy(); });
}

$(document).ready(function () {
    cargarAgentes();
    if (!esAdmin) { cargarReporte(); }
});
</script>
}
