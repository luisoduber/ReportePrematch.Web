@{
    Layout = "_Layout";
}

<style>
    .canal-toggle { display:inline-flex; border:1px solid rgba(255,255,255,0.25); border-radius:30px; overflow:hidden; }
    .tog-btn { border:none; background:rgba(255,255,255,0.07); color:rgba(255,255,255,0.35); padding:8px 20px; font-size:11px; font-weight:700; letter-spacing:.8px; cursor:pointer; transition:all .25s; white-space:nowrap; }
    .tog-btn.active { background:var(--sa-5,#0077B6); color:#fff; }
    .quick-metrics-bar { display:flex; gap:.5rem; flex-wrap:wrap; }
    .metric-card { flex:1; min-width:120px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:.5rem .75rem; text-align:center; }
    .metric-label { font-size:.65rem; color:rgba(255,255,255,0.5); letter-spacing:.5px; text-transform:uppercase; margin-bottom:.25rem; }
    .metric-value { font-size:1.05rem; font-weight:700; }
    .metric-blue  { color:#48CAE4; }
    .metric-red   { color:#f87171; }
    .metric-green { color:#4ade80; }
</style>

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub" id="canalSub">Canal Taquilla · Usuario: <strong>@ViewBag.Usuario</strong></div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <!-- Filtros -->
    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3 d-flex flex-column align-items-center justify-content-end pb-1">
                <label class="field-label mb-1">Canal</label>
                <div class="canal-toggle">
                    <button class="tog-btn active" id="btnCanalTaq" onclick="setCanal('taq')">TAQUILLA</button>
                    <button class="tog-btn"        id="btnCanalWeb" onclick="setCanal('web')">WEB</button>
                </div>
            </div>
            <div class="col-md-2">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <!-- Métricas Taquilla -->
    <div id="metricsBarTaq" class="quick-metrics-bar mt-3" style="display:none;">
        <div class="metric-card"><div class="metric-label">Total Ventas</div><div class="metric-value metric-blue" id="metTotalVentas">—</div></div>
        <div class="metric-card"><div class="metric-label">Total Premios</div><div class="metric-value metric-red" id="metTotalPremios">—</div></div>
        <div class="metric-card"><div class="metric-label">Pendientes</div><div class="metric-value metric-blue" id="metPendientes">—</div></div>
        <div class="metric-card"><div class="metric-label">Utilidad</div><div class="metric-value metric-green" id="metUtilidad">—</div></div>
    </div>

    <!-- Métricas Web -->
    <div id="metricsBarWeb" class="quick-metrics-bar mt-3" style="display:none;">
        <div class="metric-card"><div class="metric-label">Ventas Parlay</div><div class="metric-value metric-blue" id="metVP">—</div></div>
        <div class="metric-card"><div class="metric-label">Ventas Directo</div><div class="metric-value metric-blue" id="metVD">—</div></div>
        <div class="metric-card"><div class="metric-label">Premios Parlay</div><div class="metric-value metric-red" id="metPP">—</div></div>
        <div class="metric-card"><div class="metric-label">Premios Directo</div><div class="metric-value metric-red" id="metPD">—</div></div>
        <div class="metric-card"><div class="metric-label">Balance</div><div class="metric-value metric-green" id="metBal">—</div></div>
    </div>

    <!-- Tabla -->
    <div class="table-responsive mt-3">
        <table id="@ViewBag.TableId" class="glass-table w-100">
            <thead>
                <tr id="theadRow">
                    <th style="text-align:center;"></th>
                    <th style="text-align:center;">Usuario</th>
                    <th style="text-align:center;">Ventas Dir</th>
                    <th style="text-align:center;">Ventas Par</th>
                    <th style="text-align:center;">Total Ventas</th>
                    <th style="text-align:center;">Premios Dir</th>
                    <th style="text-align:center;">Premios Par</th>
                    <th style="text-align:center;">Total Premios</th>
                    <th style="text-align:center;">Pendientes</th>
                    <th style="text-align:center;">Utilidad</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
                <tr id="tfootRow">
                    <th colspan="2" style="text-align:center;">TOTAL</th>
                    <th id="totVentaDir"     style="text-align:center;"></th>
                    <th id="totVentaPar"     style="text-align:center;"></th>
                    <th id="totTotalVentas"  style="text-align:center;"></th>
                    <th id="totPremiosDir"   style="text-align:center;"></th>
                    <th id="totPremiosPar"   style="text-align:center;"></th>
                    <th id="totTotalPremios" style="text-align:center;"></th>
                    <th id="totPendientes"   style="text-align:center;"></th>
                    <th id="totUtilidad"     style="text-align:center;"></th>
                </tr>
            </tfoot>
        </table>
    </div>
</section>

@section Scripts {
<script>
const tableId       = '#@ViewBag.TableId';
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';
const urlTaq        = '@Url.Action("GetVentasPorAgenteTaq","Reportes")';
const urlWeb        = '@Url.Action("GetVentasPorAgenteWeb","Reportes")';
let canal = 'taq';
let dt;
let ticketsCache = {};

function fmt(v) {
    return parseFloat(v || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function fmtFecha(val) {
    if (!val) return '—';
    var s = val.toString().trim();
    var partes = s.split(/[T ]/);
    var fechaParte = partes[0] || s;
    var hora = partes[1] ? partes[1].substring(0, 5) : '';
    if (/^\d{4}-\d{2}-\d{2}$/.test(fechaParte)) {
        var fp = fechaParte.split('-');
        fechaParte = fp[2] + '/' + fp[1] + '/' + fp[0];
    }
    return hora ? fechaParte + ' ' + hora : fechaParte;
}

function setHeadersTaq() {
    document.getElementById('theadRow').innerHTML =
        '<th style="text-align:center;"></th>' +
        '<th style="text-align:center;">Usuario</th>' +
        '<th style="text-align:center;">Ventas Dir</th>' +
        '<th style="text-align:center;">Ventas Par</th>' +
        '<th style="text-align:center;">Total Ventas</th>' +
        '<th style="text-align:center;">Premios Dir</th>' +
        '<th style="text-align:center;">Premios Par</th>' +
        '<th style="text-align:center;">Total Premios</th>' +
        '<th style="text-align:center;">Pendientes</th>' +
        '<th style="text-align:center;">Utilidad</th>';
    document.getElementById('tfootRow').innerHTML =
        '<th colspan="2" style="text-align:center;">TOTAL</th>' +
        '<th id="totVentaDir" style="text-align:center;"></th>' +
        '<th id="totVentaPar" style="text-align:center;"></th>' +
        '<th id="totTotalVentas" style="text-align:center;"></th>' +
        '<th id="totPremiosDir" style="text-align:center;"></th>' +
        '<th id="totPremiosPar" style="text-align:center;"></th>' +
        '<th id="totTotalPremios" style="text-align:center;"></th>' +
        '<th id="totPendientes" style="text-align:center;"></th>' +
        '<th id="totUtilidad" style="text-align:center;"></th>';
}

function setHeadersWeb() {
    document.getElementById('theadRow').innerHTML =
        '<th style="text-align:center;">Agente</th>' +
        '<th style="text-align:center;">Usuario</th>' +
        '<th style="text-align:center;">País</th>' +
        '<th style="text-align:center;">Venta Par</th>' +
        '<th style="text-align:center;">Venta Dir</th>' +
        '<th style="text-align:center;">Premios Par</th>' +
        '<th style="text-align:center;">Premios Dir</th>' +
        '<th style="text-align:center;">Balance</th>';
    document.getElementById('tfootRow').innerHTML =
        '<th colspan="3" style="text-align:center;">TOTAL</th>' +
        '<th id="tVP" style="text-align:center;"></th>' +
        '<th id="tVD" style="text-align:center;"></th>' +
        '<th id="tPP" style="text-align:center;"></th>' +
        '<th id="tPD" style="text-align:center;"></th>' +
        '<th id="tBal" style="text-align:center;"></th>';
}

function setCanal(c) {
    if (canal === c) return;
    canal = c;
    document.getElementById('btnCanalTaq').classList.toggle('active', c === 'taq');
    document.getElementById('btnCanalWeb').classList.toggle('active', c === 'web');
    document.getElementById('canalSub').innerHTML = c === 'taq'
        ? 'Canal Taquilla · Usuario: <strong>@ViewBag.Usuario</strong>'
        : 'Canal Web · Usuario: <strong>@ViewBag.Usuario</strong>';
    if (dt) { dt.destroy(); dt = null; }
    $(tableId + ' tbody').empty();
    ticketsCache = {};
    document.getElementById('metricsBarTaq').style.display = 'none';
    document.getElementById('metricsBarWeb').style.display = 'none';
    if (c === 'taq') setHeadersTaq(); else setHeadersWeb();
}

function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgencias","Reportes")', { agente: agenteSession })
        .done(function (lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function (a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, { maxOptions: 2000, create: false, allowEmptyOption: true, placeholder: 'Buscar agente...', searchField: ['text'] });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
        })
        .fail(function (xhr) {
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes (HTTP ' + xhr.status + ').', background: '#002E5C', color: '#fff' });
        });
}

// ── Child row (solo Taquilla) ─────────────────────────────────────────────────
function buildDetalleHTML(tickets) {
    if (!tickets || !tickets.length) return '<div class="p-2" style="color:#aac;">Sin tickets para este usuario.</div>';
    var rows = '';
    tickets.forEach(function(t) {
        rows += '<tr style="text-align:center;">'
            + '<td class="col-ticket">' + (t.ticket || '—') + '</td>'
            + '<td>' + (t.tipoAp || '—') + '</td>'
            + '<td class="col-monto-pos">' + fmt(t.arriesgando) + '</td>'
            + '<td class="col-monto-neg">' + fmt(t.ganando) + '</td>'
            + '<td>' + (t.operacion || '—') + '</td>'
            + '<td>' + fmtFecha(t.fecha) + '</td>'
            + '</tr>';
    });
    return '<div class="p-2"><table class="glass-table w-100" style="font-size:1em;text-align:center;">'
        + '<thead><tr><th>Ticket</th><th>Tipo Apuesta</th><th>Riesgo</th><th>Premio</th><th>Operación</th><th>Fecha</th></tr></thead>'
        + '<tbody>' + rows + '</tbody></table></div>';
}

function toggleDetalle(tr, row) {
    if (row.child.isShown()) { row.child.hide(); tr.querySelector('.btn-expand').textContent = '+'; tr.classList.remove('shown'); return; }
    const d = row.data();
    const agente = d.agente || '';
    const usuario = d.usuario || '';
    const fechaD = document.getElementById('fechaD').value;
    const fechaH = document.getElementById('fechaH').value;
    const cacheKey = agente + '|' + fechaD + '|' + fechaH;
    function mostrar(tickets) {
        var filtrados = (tickets || []).filter(function(t){ return t.usuario === usuario; });
        row.child(buildDetalleHTML(filtrados)).show();
        tr.querySelector('.btn-expand').textContent = '−';
        tr.classList.add('shown');
    }
    if (ticketsCache[cacheKey] !== undefined) { mostrar(ticketsCache[cacheKey]); return; }
    row.child('<div class="p-2" style="color:#aac;">Cargando...</div>').show();
    tr.querySelector('.btn-expand').textContent = '−';
    tr.classList.add('shown');
    $.post('@Url.Action("GetTicketsDetalladosTaq","Reportes")', { fechaD, fechaH, agente: agente || 'TODOS' })
        .done(function(tickets) {
            ticketsCache[cacheKey] = tickets || [];
            mostrar(ticketsCache[cacheKey]);
        })
        .fail(function() { row.child('<div class="p-2" style="color:#f88;">Error al cargar tickets.</div>').show(); });
}

// ── Cargar reporte ────────────────────────────────────────────────────────────
function cargarReporte() {
    const fechaD = document.getElementById('fechaD').value;
    const fechaH = document.getElementById('fechaH').value;
    const agente = document.getElementById('agente').value || 'TODOS';
    if (!fechaD || !fechaH) { Swal.fire({ icon: 'warning', title: 'Fechas requeridas', background: '#002E5C', color: '#fff' }); return; }

    ticketsCache = {};
    showBusy(canal === 'taq' ? 'Consultando ventas taquilla...' : 'Consultando ventas web...');

    $.post(canal === 'taq' ? urlTaq : urlWeb, { fechaD, fechaH, agente })
        .done(function (data) {
            hideBusy();
            if (!data || !data.length) { Swal.fire({ icon: 'info', title: 'Sin resultados', text: 'No hay datos para el período seleccionado.', background: '#002E5C', color: '#fff' }); return; }

            if (dt) { dt.destroy(); }

            if (canal === 'taq') {
                // ── Taquilla ──────────────────────────────────────────────
                let totVD=0, totVP=0, totTV=0, totPD=0, totPP=0, totTP=0, totPen=0, totUtil=0;
                data.forEach(function(r) {
                    totVD   += parseFloat(r.ventaDir    || 0);
                    totVP   += parseFloat(r.ventaPar    || 0);
                    totTV   += parseFloat(r.totalVentas || 0);
                    totPD   += parseFloat(r.premiosDir  || 0);
                    totPP   += parseFloat(r.premiosPar  || 0);
                    totTP   += parseFloat(r.totalPremios|| 0);
                    totPen  += parseFloat(r.pendientes  || 0);
                    totUtil += parseFloat(r.utilidad    || 0);
                });
                document.getElementById('metTotalVentas').textContent  = fmt(totTV);
                document.getElementById('metTotalPremios').textContent = fmt(totTP);
                document.getElementById('metPendientes').textContent   = fmt(totPen);
                document.getElementById('metUtilidad').textContent     = fmt(totUtil);
                document.getElementById('metricsBarTaq').style.display = 'flex';

                dt = $(tableId).DataTable({
                    data,
                    columns: [
                        { className: 'dt-control text-center', orderable: false, data: null, defaultContent: '',
                          createdCell: function(td) { var btn = document.createElement('button'); btn.className = 'btn-expand btn-glass btn-primary btn-sm'; btn.style.cssText = 'padding:1px 7px;font-size:.9em;min-width:24px;'; btn.textContent = '+'; td.appendChild(btn); } },
                        { data: 'usuario',      defaultContent: '—', className: 'text-center' },
                        { data: 'ventaDir',     className: 'text-center', createdCell: function(td,d){ $(td).text(fmt(d)).addClass('col-monto-pos'); } },
                        { data: 'ventaPar',     className: 'text-center', createdCell: function(td,d){ $(td).text(fmt(d)).addClass('col-monto-pos'); } },
                        { data: 'totalVentas',  className: 'text-center', createdCell: function(td,d){ $(td).text(fmt(d)).addClass('col-monto-pos'); } },
                        { data: 'premiosDir',   className: 'text-center', createdCell: function(td,d){ $(td).text(fmt(d)).addClass('col-monto-neg'); } },
                        { data: 'premiosPar',   className: 'text-center', createdCell: function(td,d){ $(td).text(fmt(d)).addClass('col-monto-neg'); } },
                        { data: 'totalPremios', className: 'text-center', createdCell: function(td,d){ $(td).text(fmt(d)).addClass('col-monto-neg'); } },
                        { data: 'pendientes',   className: 'text-center', createdCell: function(td,d){ $(td).text(fmt(d)).addClass('col-monto-pos'); } },
                        { data: 'utilidad',     className: 'text-center', createdCell: function(td,d){ var n=parseFloat(d||0); $(td).text(fmt(d)).addClass(n>=0?'col-monto-pos':'col-monto-neg'); } }
                    ],
                    footerCallback: function() {
                        document.getElementById('totVentaDir').textContent    = fmt(totVD);
                        document.getElementById('totVentaPar').textContent    = fmt(totVP);
                        document.getElementById('totTotalVentas').textContent = fmt(totTV);
                        document.getElementById('totPremiosDir').textContent  = fmt(totPD);
                        document.getElementById('totPremiosPar').textContent  = fmt(totPP);
                        document.getElementById('totTotalPremios').textContent= fmt(totTP);
                        document.getElementById('totPendientes').textContent  = fmt(totPen);
                        document.getElementById('totUtilidad').textContent    = fmt(totUtil);
                    },
                    language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
                    pageLength: 25, order: [[1,'asc']], dom: 'Bfrtip',
                    buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm' }]
                });
                $(tableId + ' tbody').on('click', '.btn-expand', function() {
                    var tr = $(this).closest('tr')[0];
                    toggleDetalle(tr, dt.row(tr));
                });

            } else {
                // ── Web ───────────────────────────────────────────────────
                let vP=0, vD=0, pP=0, pD=0;
                data.forEach(function(r) { vP+=parseFloat(r.ventaPar||0); vD+=parseFloat(r.ventaDir||0); pP+=parseFloat(r.premiosPar||0); pD+=parseFloat(r.premiosDir||0); });
                const bal = (vP + vD) - (pP + pD);
                document.getElementById('metVP').textContent  = fmt(vP);
                document.getElementById('metVD').textContent  = fmt(vD);
                document.getElementById('metPP').textContent  = fmt(pP);
                document.getElementById('metPD').textContent  = fmt(pD);
                document.getElementById('metBal').textContent = fmt(bal);
                document.getElementById('metricsBarWeb').style.display = 'flex';

                dt = $(tableId).DataTable({
                    data,
                    columns: [
                        { data: 'agente',     defaultContent: '—', className: 'text-center' },
                        { data: 'usuario',    defaultContent: '—', className: 'text-center' },
                        { data: 'pais',       defaultContent: '—', className: 'text-center' },
                        { data: 'ventaPar',   className: 'text-center', createdCell: function(td,d){ $(td).text(fmt(d)).addClass('col-monto-pos'); } },
                        { data: 'ventaDir',   className: 'text-center', createdCell: function(td,d){ $(td).text(fmt(d)).addClass('col-monto-pos'); } },
                        { data: 'premiosPar', className: 'text-center', createdCell: function(td,d){ $(td).text(fmt(d)).addClass('col-monto-neg'); } },
                        { data: 'premiosDir', className: 'text-center', createdCell: function(td,d){ $(td).text(fmt(d)).addClass('col-monto-neg'); } },
                        { data: null, className: 'text-center', createdCell: function(td,_,r){ var b=(parseFloat(r.ventaPar||0)+parseFloat(r.ventaDir||0))-(parseFloat(r.premiosPar||0)+parseFloat(r.premiosDir||0)); $(td).text(fmt(b)).addClass(b>=0?'col-monto-pos':'col-monto-neg'); } }
                    ],
                    footerCallback: function() {
                        document.getElementById('tVP').textContent  = fmt(vP);
                        document.getElementById('tVD').textContent  = fmt(vD);
                        document.getElementById('tPP').textContent  = fmt(pP);
                        document.getElementById('tPD').textContent  = fmt(pD);
                        document.getElementById('tBal').textContent = fmt(bal);
                    },
                    language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
                    pageLength: 25, order: [[0,'asc']], dom: 'Bfrtip',
                    buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm' }]
                });
            }
        })
        .fail(function() {
            hideBusy();
            Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudo obtener la información.', background: '#002E5C', color: '#fff' });
        });
}

$(document).ready(function () {
    cargarAgentes();
    if (!esAdmin) { cargarReporte(); }
});
</script>
}
