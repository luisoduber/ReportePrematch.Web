@{
    Layout = "_Layout";
}

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub">Props · Apuestas especiales</div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <!-- Cards totalizados -->
    <div id="cards-totales" class="row g-3 mt-2" style="display:none!important;">
        <div class="col-6 col-md-3">
            <div class="glass-panel p-3 text-center h-100">
                <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                    <i class="ti ti-coin" style="font-size:1.3rem;color:#4ade80;"></i>
                    <span class="field-label mb-0" style="font-size:.75rem;letter-spacing:.08em;">VENTAS</span>
                </div>
                <div id="tot-ventas" class="fw-bold" style="font-size:1.25rem;color:#4ade80;">0,00</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-panel p-3 text-center h-100">
                <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                    <i class="ti ti-trophy" style="font-size:1.3rem;color:#f87171;"></i>
                    <span class="field-label mb-0" style="font-size:.75rem;letter-spacing:.08em;">PREMIOS</span>
                </div>
                <div id="tot-premios" class="fw-bold" style="font-size:1.25rem;color:#f87171;">0,00</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-panel p-3 text-center h-100">
                <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                    <i class="ti ti-arrow-back-up" style="font-size:1.3rem;color:#fb923c;"></i>
                    <span class="field-label mb-0" style="font-size:.75rem;letter-spacing:.08em;">RETORNO</span>
                </div>
                <div id="tot-retorno" class="fw-bold" style="font-size:1.25rem;color:#fb923c;">0,00</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-panel p-3 text-center h-100">
                <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                    <i class="ti ti-scale" style="font-size:1.3rem;" id="ico-balance"></i>
                    <span class="field-label mb-0" style="font-size:.75rem;letter-spacing:.08em;">BALANCE</span>
                </div>
                <div id="tot-balance" class="fw-bold" style="font-size:1.25rem;">0,00</div>
            </div>
        </div>
    </div>

    <div class="table-responsive mt-3">
        <table id="@ViewBag.TableId" class="glass-table w-100">
            <thead>
                <tr>
                    <th class="text-center">Agente</th>
                    <th class="text-center">Usuario</th>
                    <th class="text-center">Ventas</th>
                    <th class="text-center">Premios</th>
                    <th class="text-center">Retorno</th>
                    <th class="text-center">Balance</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

@section Scripts {
<script>
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';

function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgenciasApi","Reportes")')
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, {
                maxOptions: 2000,
                create: false,
                allowEmptyOption: true,
                placeholder: 'Buscar agente...',
                searchField: ['text']
            });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
            console.log('[Agentes] ' + (lista ? lista.length : 0) + ' agentes cargados.');
        })
        .fail(function(xhr) {
            console.error('[Agentes] Error HTTP ' + xhr.status + ' al cargar agentes:', xhr.responseText);
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes (HTTP ' + xhr.status + ').', background: '#002E5C', color: '#fff' });
        });
}

let dt;
function fmt(v){ return parseFloat(v||0).toLocaleString('es-VE',{minimumFractionDigits:2,maximumFractionDigits:2}); }

// Parsea string es-VE (ej: "1.234,56") a número
function parseEsVE(s){ return parseFloat((s||'0').replace(/\./g,'').replace(',','.')); }

function actualizarCards(data) {
    var totVentas  = 0, totPremios = 0, totRetorno = 0, totBalance = 0;
    data.forEach(function(r) {
        totVentas  += parseEsVE(r.ventas);
        totPremios += parseEsVE(r.premios);
        totRetorno += parseEsVE(r.retorno);
        totBalance += parseEsVE(r.utilidad);
    });

    document.getElementById('tot-ventas').textContent  = fmt(totVentas);
    document.getElementById('tot-premios').textContent = fmt(totPremios);
    document.getElementById('tot-retorno').textContent = fmt(totRetorno);

    var elBal = document.getElementById('tot-balance');
    var elIco = document.getElementById('ico-balance');
    elBal.textContent = fmt(totBalance);
    if (totBalance < 0) {
        elBal.style.color = '#f87171';
        elIco.style.color = '#f87171';
    } else {
        elBal.style.color = '#4ade80';
        elIco.style.color = '#4ade80';
    }

    document.getElementById('cards-totales').style.removeProperty('display');
    document.getElementById('cards-totales').style.display = 'flex';
    document.getElementById('cards-totales').classList.add('flex-wrap');
}

function cargarReporte(){
    const fechaD=document.getElementById('fechaD').value;
    const fechaH=document.getElementById('fechaH').value;
    const agente=document.getElementById('agente').value||'TODOS';
    if(!fechaD||!fechaH){Swal.fire({icon:'warning',title:'Fechas requeridas',background:'#002E5C',color:'#fff'});return;}
    showBusy('Consultando...');

    $.post('@Url.Action("GetProps","Reportes")',{fechaD,fechaH,agente})
        .done(function(data){
            if(!data||!data.length){
                document.getElementById('cards-totales').style.display='none';
                Swal.fire({icon:'info',title:'Sin resultados',background:'#002E5C',color:'#fff'});
                hideBusy();
                return;
            }
            actualizarCards(data);
            if(dt)dt.destroy();
            dt=$('#@ViewBag.TableId').DataTable({
                data,
                columns: [
                    {data:'agente',  className:'text-center'},
                    {data:'usuario', className:'text-center'},
                    {data:'ventas',  className:'text-center', createdCell:function(td){$(td).addClass('col-monto-pos');}},
                    {data:'premios', className:'text-center', createdCell:function(td){$(td).addClass('col-monto-neg');}},
                    {data:'retorno', className:'text-center', createdCell:function(td){$(td).addClass('col-monto-neg');}},
                    {data:'utilidad',className:'text-center', createdCell:function(td,d){var n=parseFloat((d||'0').replace(/\./g,'').replace(',','.'));$(td).addClass(n<0?'col-monto-neg':'col-monto-pos');}}
                ],
                language:{url:'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json'},
                pageLength:25,order:[[0,'asc']],dom:'Bfrtip',
                buttons:[{extend:'excelHtml5',text:'<i class="ti ti-file-spreadsheet"></i> Excel',className:'btn-glass btn-primary btn-sm'}]
            });
            hideBusy();
        }).fail(function(){Swal.fire({icon:'error',title:'Error',background:'#002E5C',color:'#fff'});hideBusy();});
}
$(document).ready(function () {
    cargarAgentes();
    if (!esAdmin) { cargarReporte(); }
});
</script>
}
