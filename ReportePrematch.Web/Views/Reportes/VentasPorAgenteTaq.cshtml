@{
    Layout = "_Layout";
}

<section class="glass-card">
    <!-- Cabecera -->
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub">Canal Taquilla · Usuario: <strong>@ViewBag.Usuario</strong></div>
        </div>
        <button id="@ViewBag.BtnId" class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <!-- Filtros -->
    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3" id="agenteWrapper">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <!-- Usuario Regular: solo ve su propio agente -->
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <!-- suAdmin / Administrador: select con lista de agencias -->
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <!-- Métricas rápidas -->
    <div class="quick-metrics-bar mt-3" id="metricsBar" style="display:none;">
        <div class="metric-card">
            <div class="metric-label">Ventas Parlay</div>
            <div class="metric-value metric-blue" id="metVentaPar">—</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Ventas Directo</div>
            <div class="metric-value metric-blue" id="metVentaDir">—</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Premios Parlay</div>
            <div class="metric-value metric-red" id="metPremiosPar">—</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Premios Directo</div>
            <div class="metric-value metric-red" id="metPremiosDir">—</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Balance</div>
            <div class="metric-value metric-green" id="metBalance">—</div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="table-responsive mt-3">
        <table id="@ViewBag.TableId" class="glass-table w-100">
            <thead>
                <tr>
                    <th>Agente</th>
                    <th>Usuario</th>
                    <th>País</th>
                    <th>Venta Par</th>
                    <th>Venta Dir</th>
                    <th>Premios Par</th>
                    <th>Premios Dir</th>
                    <th>Balance</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
                <tr>
                    <th colspan="3">TOTAL</th>
                    <th id="totVentaPar"></th>
                    <th id="totVentaDir"></th>
                    <th id="totPremiosPar"></th>
                    <th id="totPremiosDir"></th>
                    <th id="totBalance"></th>
                </tr>
            </tfoot>
        </table>
    </div>
</section>

@section Scripts {
<script>
const tableId  = '#@ViewBag.TableId';
const esAdmin  = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';
let dt;
let balance = 0;

function fmt(val) {
    return parseFloat(val || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

// ── Cargar lista de agentes en el select ──────────────────────────────────────
function cargarAgentes() {
    if (!esAdmin) return; // Usuario Regular no necesita el select

    $.post('@Url.Action("GetListAgencias", "Reportes")', { agente: agenteSession })
        .done(function (lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;

            // Destruir instancia Tom Select previa si existe
            if (sel.tomselect) sel.tomselect.destroy();

            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = '';
            optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);

            if (!lista || lista.length === 0) {
                console.warn('[Agentes] Lista vacía.');
            } else {
                lista.forEach(function (a) {
                    const opt = document.createElement('option');
                    opt.value = a;
                    opt.textContent = a;
                    sel.appendChild(opt);
                });
            }

            // Inicializar Tom Select con búsqueda
            new TomSelect(sel, {
                maxOptions: 2000,
                create: false,
                allowEmptyOption: true,
                placeholder: 'Buscar agente...',
                searchField: ['text']
            });

            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
            console.log('[Agentes] ' + (lista ? lista.length : 0) + ' agentes cargados OK.');
        })
        .fail(function (xhr) {
            console.error('[Agentes] Error HTTP ' + xhr.status);
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes (HTTP ' + xhr.status + ').', background: '#002E5C', color: '#fff' });
        });
}

// ── Cargar reporte ────────────────────────────────────────────────────────────
function cargarReporte() {
    const fechaD = document.getElementById('fechaD').value;
    const fechaH = document.getElementById('fechaH').value;
    const agente = document.getElementById('agente').value;

    if (!fechaD || !fechaH) {
        Swal.fire({ icon: 'warning', title: 'Fechas requeridas', text: 'Selecciona el rango de fechas.', background: '#002E5C', color: '#fff' });
        return;
    }

    // Usuario Regular siempre debe tener agente; Admin puede buscar todos (agente vacío = TODOS)
    if (!esAdmin && !agente) {
        Swal.fire({ icon: 'warning', title: 'Agente requerido', text: 'Selecciona un agente de la lista.', background: '#002E5C', color: '#fff' });
        return;
    }

    showBusy('Consultando ventas taquilla...');

    $.post('@Url.Action("GetVentasPorAgenteTaq", "Reportes")', { fechaD, fechaH, agente })
        .done(function (data) {
            if (!data || data.length === 0) {
                Swal.fire({ icon: 'info', title: 'Sin resultados', text: 'No hay datos para el período seleccionado.', background: '#002E5C', color: '#fff' });
                hideBusy();
                return;
            }

            // Totales
            let totVP = 0, totVD = 0, totPP = 0, totPD = 0;
            data.forEach(r => {
                totVP += parseFloat(r.ventaPar   || 0);
                totVD += parseFloat(r.ventaDir   || 0);
                totPP += parseFloat(r.premiosPar || 0);
                totPD += parseFloat(r.premiosDir || 0);
            });
            balance = (totVP + totVD) - (totPP + totPD);

            // Métricas
            document.getElementById('metVentaPar').textContent   = fmt(totVP);
            document.getElementById('metVentaDir').textContent   = fmt(totVD);
            document.getElementById('metPremiosPar').textContent = fmt(totPP);
            document.getElementById('metPremiosDir').textContent = fmt(totPD);
            document.getElementById('metBalance').textContent    = fmt(balance);
            document.getElementById('metricsBar').style.display  = 'flex';

            // DataTable
            if (dt) { dt.destroy(); }
            dt = $(tableId).DataTable({
                data: data,
                columns: [
                    { data: 'agente' },
                    { data: 'usuario' },
                    { data: 'pais', defaultContent: '—' },
                    { data: 'ventaPar',    render: d => `<span class="col-monto-pos">${fmt(d)}</span>` },
                    { data: 'ventaDir',    render: d => `<span class="col-monto-pos">${fmt(d)}</span>` },
                    { data: 'premiosPar',  render: d => `<span class="col-monto-neg">${fmt(d)}</span>` },
                    { data: 'premiosDir',  render: d => `<span class="col-monto-neg">${fmt(d)}</span>` },
                    {
                        data: null,
                        render: r => {
                            const b = (parseFloat(r.ventaPar || 0) + parseFloat(r.ventaDir || 0))
                                    - (parseFloat(r.premiosPar || 0) + parseFloat(r.premiosDir || 0));
                            return `<span class="${b >= 0 ? 'col-monto-pos' : 'col-monto-neg'}">${fmt(b)}</span>`;
                        }
                    }
                ],
                footerCallback: function () {
                    document.getElementById('totVentaPar').textContent   = fmt(totVP);
                    document.getElementById('totVentaDir').textContent   = fmt(totVD);
                    document.getElementById('totPremiosPar').textContent = fmt(totPP);
                    document.getElementById('totPremiosDir').textContent = fmt(totPD);
                    document.getElementById('totBalance').textContent    = fmt(balance);
                },
                language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
                pageLength: 25,
                order: [[0, 'asc']],
                dom: 'Bfrtip',
                buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm' }]
            });

            hideBusy();
        })
        .fail(function () {
            Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudo obtener la información.', background: '#002E5C', color: '#fff' });
            hideBusy();
        });
}

// ── Init ──────────────────────────────────────────────────────────────────────
$(document).ready(function () {
    cargarAgentes(); // Carga el select (solo para admin/suAdmin)

    // Usuario Regular carga automático; admin/suAdmin espera que seleccione agente
    if (!esAdmin) {
        cargarReporte();
    }
});
</script>
}
