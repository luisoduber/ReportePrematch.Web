@{
    Layout = "_Layout";
}

<style>
.agent-block { margin-bottom: 2rem; }
.agent-block-header {
    display: flex; align-items: center; gap: .6rem;
    font-size: 1rem; font-weight: 700; letter-spacing: .04em;
    color: #48CAE4; margin-bottom: .6rem;
    padding-bottom: .35rem;
    border-bottom: 1px solid rgba(72,202,228,.25);
}
.agent-block-header i { font-size: 1.1rem; }

.quick-metrics-bar { display:flex; gap:.5rem; flex-wrap:wrap; }
.metric-card { flex:1; min-width:120px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:.5rem .75rem; text-align:center; }
@@media (max-width:768px) { .metric-card { min-width:90px; flex:1 1 90px; padding:.45rem .55rem; } }
@@media (max-width:430px) { .metric-card { min-width:72px; flex:1 1 72px; padding:.38rem .45rem; } .metric-value { font-size:.88rem; } }
.metric-label { font-size:.62rem; color:rgba(255,255,255,0.5); letter-spacing:.5px; text-transform:uppercase; margin-bottom:.25rem; }
.metric-value { font-size:.95rem; font-weight:700; }
.metric-blue  { color:#48CAE4; }
.metric-red   { color:#f87171; }
.metric-green { color:#4ade80; }
.metric-yellow{ color:#fbbf24; }
.metric-purple{ color:#c084fc; }

#globalCards { display:flex; gap:.6rem; flex-wrap:wrap; margin-bottom:1.25rem; }
#globalCards .metric-card { min-width:140px; padding:.65rem 1rem; }
#globalCards .metric-value { font-size:1.05rem; }
</style>

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub">Casino · IconBet Slots por Agente</div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <!-- Cards globales -->
    <div id="globalCards" class="mt-3 d-none"></div>

    <!-- Barra exportacion -->
    <div id="exportBar" class="mt-2 d-none d-flex gap-2 flex-wrap">
        <button class="btn-glass btn-primary" onclick="exportExcel()">
            <i class="ti ti-file-spreadsheet"></i> Excel completo
        </button>
        <button class="btn-glass" style="border-color:rgba(255,100,100,.5);color:#f87171;" onclick="exportPDF()">
            <i class="ti ti-file-type-pdf"></i> PDF por agente
        </button>
    </div>

    <!-- Bloques por agente -->
    <div id="agentBlocks" class="mt-3"></div>
</section>

@section Scripts {
<script>
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';
let lastData = [];
let dtInstances = [];

/* ── formateo ─────────────────────────────────────────────────────────── */
function fmt(v) {
    return parseFloat(v || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function fmtPct(v) {
    return parseFloat(v || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' %';
}
function fmtInt(v) {
    return parseInt(v || 0).toLocaleString('es-VE');
}

/* ── accesores de campo (camelCase JSON del API) ──────────────────────── */
function fAg(r)        { return r.agent          || r.Agent          || '(Sin Agente)'; }
function fUser(r)      { return r.userName        || r.UserName       || '—'; }
function fCur(r)       { return r.currency        || r.Currency       || ''; }
function fRtpG(r)      { return r.rtP_General     || r.RTP_General    || 0; }
function fRtpAg(r)     { return r.rtP_Agente      || r.RTP_Agente     || 0; }
function fRtpUs(r)     { return r.rtP_Usuario     || r.RTP_Usuario    || 0; }
function fRiesOrig(r)  { return r.riesgoOrig      || r.RiesgoOrig     || '0,00'; }
function fPremOrig(r)  { return r.premiosOrig     || r.PremiosOrig    || '0,00'; }
function fGgrOrig(r)   { return r.ggR_Orig        || r.GGR_Orig       || '0,00'; }
function fRiesUSD(r)   { return r.riesgoUSD       || r.RiesgoUSD      || '0,00'; }
function fPremUSD(r)   { return r.premiosUSD      || r.PremiosUSD     || '0,00'; }
function fGgrUSD(r)    { return r.ggR_USD         || r.GGR_USD        || '0,00'; }

/* convierte string venezolano "1.234.567,89" a number para aritmética */
function numericVal(v) {
    if (typeof v === 'number') return v;
    return parseFloat((v || '0').toString().replace(/\./g, '').replace(',', '.')) || 0;
}
function fDeb(r)       { return r.cantDebitos     || r.CantDebitos    || 0; }
function fCred(r)      { return r.cantCreditos    || r.CantCreditos   || 0; }
function fTrans(r)     { return r.totalTransacciones || r.TotalTransacciones || 0; }

/* ── card helper ──────────────────────────────────────────────────────── */
function card(label, value, cls) {
    return '<div class="metric-card">'
        + '<div class="metric-label">' + label + '</div>'
        + '<div class="metric-value ' + cls + '">' + value + '</div>'
        + '</div>';
}

/* ── limpiar ──────────────────────────────────────────────────────────── */
function limpiarBloques() {
    dtInstances.forEach(function(dt){ try { dt.destroy(); } catch(e){} });
    dtInstances = [];
    document.getElementById('agentBlocks').innerHTML = '';
    document.getElementById('globalCards').innerHTML = '';
    document.getElementById('globalCards').classList.add('d-none');
    lastData = [];
    document.getElementById('exportBar').classList.add('d-none');
}

/* ── cards globales ───────────────────────────────────────────────────── */
function renderGlobalCards(data) {
    var rtpGen  = parseFloat(fRtpG(data[0]) || 0);
    var totRiesUSD = 0, totPremUSD = 0, totGgrUSD = 0, totTrans = 0;
    data.forEach(function(r) {
        totRiesUSD += numericVal(fRiesUSD(r));
        totPremUSD += numericVal(fPremUSD(r));
        totGgrUSD  += numericVal(fGgrUSD(r));
        totTrans   += parseInt(fTrans(r));
    });

    var html = card('RTP General', fmtPct(rtpGen), 'metric-purple')
             + card('Riesgo USD',  fmt(totRiesUSD), 'metric-blue')
             + card('Premios USD', fmt(totPremUSD), 'metric-red')
             + card('GGR USD',     fmt(totGgrUSD),  totGgrUSD >= 0 ? 'metric-green' : 'metric-red')
             + card('Transacciones', fmtInt(totTrans), 'metric-yellow');

    var el = document.getElementById('globalCards');
    el.innerHTML = html;
    el.classList.remove('d-none');
}

/* ── render bloque por agente ─────────────────────────────────────────── */
function renderBloqueAgente(agente, rows, idx) {
    var rtpAg  = parseFloat(fRtpAg(rows[0]) || 0);
    var totRiesUSD = 0, totPremUSD = 0, totGgrUSD = 0, totTrans = 0;
    rows.forEach(function(r) {
        totRiesUSD += numericVal(fRiesUSD(r));
        totPremUSD += numericVal(fPremUSD(r));
        totGgrUSD  += numericVal(fGgrUSD(r));
        totTrans   += parseInt(fTrans(r));
    });

    var tableId = 'tblIcon_' + idx;
    var block = document.createElement('div');
    block.className = 'agent-block';
    block.innerHTML =
        '<div class="agent-block-header"><i class="ti ti-building-store"></i>' + agente + '</div>' +
        '<div class="quick-metrics-bar mb-2">' +
            card('RTP Agente',   fmtPct(rtpAg),   'metric-purple') +
            card('Riesgo USD',   fmt(totRiesUSD),  'metric-blue') +
            card('Premios USD',  fmt(totPremUSD),  'metric-red') +
            card('GGR USD',      fmt(totGgrUSD),   totGgrUSD >= 0 ? 'metric-green' : 'metric-red') +
            card('Transacciones', fmtInt(totTrans), 'metric-yellow') +
        '</div>' +
        '<div class="table-responsive">' +
        '<table id="' + tableId + '" class="glass-table w-100">' +
        '<thead><tr>' +
            '<th style="text-align:center;">Usuario</th>' +
            '<th style="text-align:center;">Moneda</th>' +
            '<th style="text-align:center;">RTP Gral %</th>' +
            '<th style="text-align:center;">RTP Ag %</th>' +
            '<th style="text-align:center;">RTP Us %</th>' +
            '<th style="text-align:center;">Riesgo (Orig)</th>' +
            '<th style="text-align:center;">Premios (Orig)</th>' +
            '<th style="text-align:center;">GGR (Orig)</th>' +
            '<th style="text-align:center;">Riesgo USD</th>' +
            '<th style="text-align:center;">Premios USD</th>' +
            '<th style="text-align:center;">GGR USD</th>' +
            '<th style="text-align:center;">Débitos</th>' +
            '<th style="text-align:center;">Créditos</th>' +
            '<th style="text-align:center;">Trans.</th>' +
        '</tr></thead><tbody></tbody>' +
        '<tfoot><tr>' +
            '<th colspan="5" style="text-align:center;">TOTAL</th>' +
            '<th style="text-align:right;"></th>' +
            '<th style="text-align:right;"></th>' +
            '<th style="text-align:right;"></th>' +
            '<th style="text-align:right;">' + fmt(totRiesUSD) + '</th>' +
            '<th style="text-align:right;">' + fmt(totPremUSD) + '</th>' +
            '<th style="text-align:right;color:' + (totGgrUSD >= 0 ? 'var(--av-5,#7FCA8A)' : '#FC8181') + ';font-weight:600;">' + fmt(totGgrUSD) + '</th>' +
            '<th style="text-align:right;"></th>' +
            '<th style="text-align:right;"></th>' +
            '<th style="text-align:right;">' + fmtInt(totTrans) + '</th>' +
        '</tr></tfoot>' +
        '</table></div>';

    document.getElementById('agentBlocks').appendChild(block);

    try {
        var dt = $('#' + tableId).DataTable({
            data: rows,
            columns: [
                { data: 'userName',           defaultContent: '—',  className: 'text-center' },
                { data: 'currency',           defaultContent: '',   className: 'text-center' },
                { data: 'rtP_General',        defaultContent: 0,    className: 'text-center',
                  render: function(d){ return fmtPct(d); } },
                { data: 'rtP_Agente',         defaultContent: 0,    className: 'text-center',
                  render: function(d){ return fmtPct(d); } },
                { data: 'rtP_Usuario',        defaultContent: 0,    className: 'text-center',
                  render: function(d){ return fmtPct(d); } },
                { data: 'riesgoOrig',         defaultContent: '0,00', className: 'text-center' },
                { data: 'premiosOrig',        defaultContent: '0,00', className: 'text-center' },
                { data: 'ggR_Orig',           defaultContent: '0,00', className: 'text-center',
                  render: function(d){ var n=numericVal(d); return '<span class="'+(n<0?'col-monto-neg':'col-monto-pos')+'">'+(d||'0,00')+'</span>'; } },
                { data: 'riesgoUSD',          defaultContent: '0,00', className: 'text-center' },
                { data: 'premiosUSD',         defaultContent: '0,00', className: 'text-center' },
                { data: 'ggR_USD',            defaultContent: '0,00', className: 'text-center',
                  render: function(d){ var n=numericVal(d); return '<span class="'+(n<0?'col-monto-neg':'col-monto-pos')+'">'+(d||'0,00')+'</span>'; } },
                { data: 'cantDebitos',        defaultContent: 0,    className: 'text-center',
                  render: function(d){ return fmtInt(d); } },
                { data: 'cantCreditos',       defaultContent: 0,    className: 'text-center',
                  render: function(d){ return fmtInt(d); } },
                { data: 'totalTransacciones', defaultContent: 0,    className: 'text-center',
                  render: function(d){ return fmtInt(d); } }
            ],
            language: {
                emptyTable: 'Sin datos', zeroRecords: 'Sin resultados',
                info: 'Mostrando _START_ a _END_ de _TOTAL_',
                infoEmpty: 'Sin registros', search: 'Buscar:',
                paginate: { first:'«', last:'»', next:'›', previous:'‹' }
            },
            pageLength: 100,
            lengthMenu: [[100, 500, 1000, -1], ['100', '500', '1000', 'Todos']],
            order: [[0, 'asc']],
            dom: 'Bfrt<"d-flex justify-content-end align-items-center mt-2"l>',
            buttons: [{
                extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel',
                className: 'btn-glass btn-primary btn-sm', title: agente
            }]
        });
        dtInstances.push(dt);
    } catch(e) {
        console.error('DataTable error bloque ' + agente + ':', e);
    }
}

/* ── agentes ──────────────────────────────────────────────────────────── */
function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgenciasApi","Reportes")')
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, { maxOptions: 2000, create: false, allowEmptyOption: true, placeholder: 'Buscar agente...', searchField: ['text'] });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
        })
        .fail(function() {
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes.', background: '#002E5C', color: '#fff' });
        });
}

/* ── carga principal ──────────────────────────────────────────────────── */
function cargarReporte() {
    const fechaD   = document.getElementById('fechaD').value;
    const fechaH   = document.getElementById('fechaH').value;
    const agenteEl = document.getElementById('agente');
    const agente   = (agenteEl ? (agenteEl.tomselect ? agenteEl.tomselect.getValue() : agenteEl.value) : agenteSession) || 'TODOS';

    if (!fechaD || !fechaH) {
        Swal.fire({ icon: 'warning', title: 'Fechas requeridas', background: '#002E5C', color: '#fff' });
        return;
    }

    limpiarBloques();
    showBusy('Consultando...');

    $.post('@Url.Action("GetIconSlot","Reportes")', { fechaD, fechaH, agente })
        .done(function(data) {
            hideBusy();
            if (!data || !data.length) {
                Swal.fire({ icon: 'info', title: 'Sin resultados', background: '#002E5C', color: '#fff' });
                return;
            }

            renderGlobalCards(data);

            // Agrupar por agente
            var grupos = {};
            var orden  = [];
            data.forEach(function(r) {
                var ag = fAg(r);
                if (!grupos[ag]) { grupos[ag] = []; orden.push(ag); }
                grupos[ag].push(r);
            });

            orden.forEach(function(ag, idx) { renderBloqueAgente(ag, grupos[ag], idx); });
            lastData = data;
            document.getElementById('exportBar').classList.remove('d-none');
        })
        .fail(function() {
            hideBusy();
            Swal.fire({ icon: 'error', title: 'Error al consultar', background: '#002E5C', color: '#fff' });
        });
}

/* ── exportacion ──────────────────────────────────────────────────────── */
var EXPORT_CONFIG = {
    reportName: 'Icon Slots',
    groupField: function(r){ return fAg(r); },
    cols: [
        { head: 'Agente',       get: function(r){ return fAg(r); },                    type: 'text'  },
        { head: 'Usuario',      get: function(r){ return fUser(r); },                  type: 'text'  },
        { head: 'Moneda',       get: function(r){ return fCur(r); },                   type: 'text'  },
        { head: 'RTP General%', get: function(r){ return parseFloat(fRtpG(r)); },      type: 'money' },
        { head: 'RTP Agente%',  get: function(r){ return parseFloat(fRtpAg(r)); },     type: 'money' },
        { head: 'RTP Usuario%', get: function(r){ return parseFloat(fRtpUs(r)); },     type: 'money' },
        { head: 'Riesgo Orig',  get: function(r){ return parseFloat(fRiesOrig(r)); },  type: 'money' },
        { head: 'Premios Orig', get: function(r){ return parseFloat(fPremOrig(r)); },  type: 'money' },
        { head: 'GGR Orig',     get: function(r){ return parseFloat(fGgrOrig(r)); },   type: 'money' },
        { head: 'Riesgo USD',   get: function(r){ return parseFloat(fRiesUSD(r)); },   type: 'money' },
        { head: 'Premios USD',  get: function(r){ return parseFloat(fPremUSD(r)); },   type: 'money' },
        { head: 'GGR USD',      get: function(r){ return parseFloat(fGgrUSD(r)); },    type: 'money' },
        { head: 'Débitos',      get: function(r){ return parseInt(fDeb(r)); },         type: 'num'   },
        { head: 'Créditos',     get: function(r){ return parseInt(fCred(r)); },        type: 'num'   },
        { head: 'Trans.',       get: function(r){ return parseInt(fTrans(r)); },        type: 'num'   }
    ]
};
function exportExcel() { ExportHelpers.exportarExcel(lastData, EXPORT_CONFIG); }
function exportPDF() {
    ExportHelpers.exportarPDF(lastData, EXPORT_CONFIG,
        document.getElementById('fechaD').value,
        document.getElementById('fechaH').value);
}

$(document).ready(function() {
    cargarAgentes();
    if (!esAdmin) { cargarReporte(); }
});
</script>
}
