@{
    Layout = "_Layout";
    string modoInicial = "taq";
}

<style>
    .canal-toggle { display:inline-flex; border:1px solid rgba(255,255,255,0.25); border-radius:30px; overflow:hidden; }
    .tog-btn { border:none; background:rgba(255,255,255,0.07); color:rgba(255,255,255,0.35); padding:8px 20px; font-size:11px; font-weight:700; letter-spacing:.8px; cursor:pointer; transition:all .25s; white-space:nowrap; }
    .tog-btn.active { background:var(--sa-5,#0077B6); color:#fff; }
    .quick-metrics-bar { display:flex; gap:.5rem; flex-wrap:wrap; }
    .metric-card { flex:1; min-width:120px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:.5rem .75rem; text-align:center; }
    @@media (max-width:768px) { .metric-card { min-width:80px; flex:1 1 80px; padding:.45rem .55rem; } }
    @@media (max-width:430px) { .metric-card { min-width:68px; flex:1 1 68px; padding:.38rem .45rem; } .metric-value { font-size:.88rem; } }
    .metric-label { font-size:.65rem; color:rgba(255,255,255,0.5); letter-spacing:.5px; text-transform:uppercase; margin-bottom:.25rem; }
    .metric-value { font-size:1.05rem; font-weight:700; }
    .metric-blue  { color:#48CAE4; }
    .metric-red   { color:#f87171; }
    .metric-green { color:#4ade80; }
</style>

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub" id="subCanal"></div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3 d-flex flex-column align-items-center justify-content-end pb-1">
                <label class="field-label mb-1">Canal</label>
                <div class="canal-toggle">
                    <button class="tog-btn active" id="btnCanalTaq" onclick="setModo('taq')">TAQUILLA</button>
                    <button class="tog-btn"        id="btnCanalWeb" onclick="setModo('web')">WEB</button>
                </div>
            </div>
            <div class="col-md-2">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <!-- Métricas -->
    <div id="metricsBar" class="quick-metrics-bar mt-3" style="display:none;">
        <div class="metric-card"><div class="metric-label">Total Riesgo</div><div class="metric-value metric-blue" id="metRiesgo">—</div></div>
        <div class="metric-card"><div class="metric-label">Total Premio</div><div class="metric-value metric-red" id="metPremio">—</div></div>
    </div>

    <div class="table-responsive mt-3">
        <table id="@ViewBag.TableId" class="glass-table w-100">
            <thead>
                <tr>
                    <th style="text-align:center;">Ticket</th>
                    <th style="text-align:center;">Agente</th>
                    <th style="text-align:center;">Usuario</th>
                    <th style="text-align:center;">Fecha</th>
                    <th style="text-align:center;">Tipo</th>
                    <th style="text-align:center;">Saldo</th>
                    <th style="text-align:center;">Riesgo</th>
                    <th style="text-align:center;">Premio</th>
                    <th style="text-align:center;">Estado</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

@section Scripts {
<script>
const tableId       = '#@ViewBag.TableId';
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';
let modoActual      = '@modoInicial';
let dt;

/* ── helpers ─────────────────────────────────────────────────────────── */
function fmt(v) { return parseFloat(v||0).toLocaleString('es-VE',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function fmtFecha(v) {
    if (!v) return '—';
    var d = new Date(v);
    if (isNaN(d)) return v;
    var pad = function(n){ return n < 10 ? '0' + n : n; };
    return pad(d.getDate()) + '/' + pad(d.getMonth()+1) + '/' + d.getFullYear() +
           ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
}

/* ── toggle ──────────────────────────────────────────────────────────── */
function aplicarModo() {
    document.getElementById('btnCanalTaq').classList.toggle('active', modoActual === 'taq');
    document.getElementById('btnCanalWeb').classList.toggle('active', modoActual === 'web');
    document.getElementById('subCanal').textContent = modoActual === 'taq'
        ? 'Canal Taquilla · Tickets Detallados'
        : 'Canal Web · Tickets Detallados';
}

function setModo(modo) {
    if (modoActual === modo) return;
    modoActual = modo;
    aplicarModo();
    if (dt) { dt.destroy(); dt = null; }
    $(tableId + ' tbody').empty();
    document.getElementById('metRiesgo').textContent = '—';
    document.getElementById('metPremio').textContent = '—';
    document.getElementById('metricsBar').style.display = 'none';
}

/* ── agentes ─────────────────────────────────────────────────────────── */
function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgenciasApi","Reportes")')
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, { maxOptions: 2000, create: false, allowEmptyOption: true, placeholder: 'Buscar agente...', searchField: ['text'] });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
        })
        .fail(function(xhr) {
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes (HTTP ' + xhr.status + ').', background: '#002E5C', color: '#fff' });
        });
}

/* ── carga principal ─────────────────────────────────────────────────── */
function cargarReporte() {
    const fechaD = document.getElementById('fechaD').value;
    const fechaH = document.getElementById('fechaH').value;
    const agente = document.getElementById('agente').value || 'TODOS';
    if (!fechaD || !fechaH) { Swal.fire({ icon:'warning', title:'Fechas requeridas', background:'#002E5C', color:'#fff' }); return; }
    showBusy('Cargando tickets...');

    const url = modoActual === 'taq'
        ? '@Url.Action("GetTicketsDetalladosTaq","Reportes")'
        : '@Url.Action("GetTicketsDetalladosWeb","Reportes")';

    $.post(url, { fechaD, fechaH, agente })
        .done(function(data) {
            if (!data || !data.length) {
                document.getElementById('metricsBar').style.display = 'none';
                Swal.fire({ icon:'info', title:'Sin resultados', background:'#002E5C', color:'#fff' });
                hideBusy(); return;
            }

            // Totales cards
            function parseAmt(v) { var s = String(v || '0').replace(/\./g,'').replace(',','.'); return parseFloat(s) || 0; }
            var totR = 0, totG = 0;
            data.forEach(function(r) { totR += parseAmt(r.riesgo); totG += parseAmt(r.ganando); });
            document.getElementById('metRiesgo').textContent = fmt(totR);
            document.getElementById('metPremio').textContent = fmt(totG);
            document.getElementById('metricsBar').style.display = 'flex';

            if (dt) dt.destroy();
            dt = $(tableId).DataTable({
                data,
                columns: [
                    { data: 'ticket',    className: 'text-center', createdCell: function(td, d){ $(td).addClass('col-ticket'); $(td).html('<span class="ticket-link" onclick="verDetalleTicket(' + d + ')" style="cursor:pointer;color:#48CAE4;text-decoration:underline;font-weight:700;">' + (d || '—') + '</span>'); } },
                    { data: 'agente',    className: 'text-center', defaultContent: '—' },
                    { data: 'usuario',   className: 'text-center', defaultContent: '—' },
                    { data: null,        className: 'text-center', defaultContent: '—', render: function(d,t,r){ return fmtFecha(r.fecha); } },
                    { data: 'tipoAp',    className: 'text-center', defaultContent: '—' },
                    { data: 'tipoSaldo', className: 'text-center', defaultContent: '—' },
                    { data: 'riesgo',    className: 'text-center', createdCell: function(td){ $(td).addClass('col-monto-pos'); } },
                    { data: 'ganando',   className: 'text-center', createdCell: function(td,d){ var n=parseFloat((d||'0').replace(/\./g,'').replace(',','.'));$(td).addClass(n<0?'col-monto-neg':'col-monto-pos'); } },
                    { data: 'operacion', className: 'text-center', defaultContent: '—' }
                ],
                language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
                pageLength: 50, order: [[2,'asc']], dom: 'Bfrtip',
                buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm' }]
            });
            hideBusy();
        })
        .fail(function(){ Swal.fire({ icon:'error', title:'Error', background:'#002E5C', color:'#fff' }); hideBusy(); });
}

$(document).ready(function() {
    aplicarModo();
    cargarAgentes();
    if (!esAdmin) { cargarReporte(); }
});

// ── Modal detalle de ticket ───────────────────────────────────────────────────
const urlDetalleTicket = '@Url.Action("GetDetalleTicket","Reportes")';

function verDetalleTicket(idticket) {
    if (!idticket) return;
    Swal.fire({
        title: 'Cargando ticket #' + idticket + '...',
        allowOutsideClick: false,
        background: '#002E5C',
        color: '#fff',
        didOpen: function() { Swal.showLoading(); }
    });
    $.post(urlDetalleTicket, { idticket: idticket })
        .done(function(res) {
            if (!res || !res.estatus) {
                Swal.fire({ icon:'error', title:'Error', text: res?.mensaje || 'No se pudo cargar el ticket.', background:'#002E5C', color:'#fff' });
                return;
            }
            const d = res.data;
            const opMap = { 1:'Pendiente', 2:'Ganador', 3:'Perdedor', 4:'Anulado', 5:'Cobrado' };
            const estatusColor = { 'Ganador':'#4ade80','Pendiente':'#48CAE4','Perdedor':'#f87171','Anulado':'#94a3b8','Cobrado':'#a78bfa' };
            const eColor = estatusColor[d.estatus] || '#94a3b8';

            var detalleRows = '';
            (d.detalles || []).forEach(function(det) {
                var ganoIcon = det.gano === 1 ? '<span style="color:#4ade80;font-weight:700;">✓</span>' : '<span style="color:#f87171;font-weight:700;">✗</span>';
                detalleRows +=
                    '<tr style="border-bottom:1px solid rgba(255,255,255,.06);">' +
                    '<td style="padding:7px 8px;text-align:center;color:#94a3b8;font-size:.8em;">' + (det.deporte || '—') + '</td>' +
                    '<td style="padding:7px 8px;text-align:center;font-size:.8em;">' + (det.liga || '—') + '</td>' +
                    '<td style="padding:7px 8px;text-align:left;font-size:.82em;font-weight:600;color:#e2e8f0;">' + (det.equipo || '—') + '</td>' +
                    '<td style="padding:7px 8px;text-align:center;font-size:.8em;color:#fbbf24;">' + (det.logro || '—') + '</td>' +
                    '<td style="padding:7px 8px;text-align:center;font-size:.8em;">' + (det.decimales || '—') + '</td>' +
                    '<td style="padding:7px 8px;text-align:center;font-size:.8em;color:#94a3b8;">' + (det.marcador || '—') + '</td>' +
                    '<td style="padding:7px 8px;text-align:center;">' + ganoIcon + '</td>' +
                    '</tr>';
            });

            var html =
                '<div style="text-align:left;">' +
                '<div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:14px;">' +
                    infoChip('Ticket',     '#' + d.ticket,            '#48CAE4') +
                    infoChip('Tipo',       d.tipoApuesta || '—',      '#a78bfa') +
                    infoChip('Estatus',    d.estatus || '—',           eColor)   +
                    infoChip('Operación',  opMap[d.operacion] || '—', '#94a3b8') +
                '</div>' +
                '<div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px;">' +
                    infoChip('Agente',   d.nombreAgente || '—', '#64748b') +
                    infoChip('Usuario',  d.usuario || '—',      '#64748b') +
                    infoChip('Fecha',    fmtFecha(d.fecha),     '#64748b') +
                '</div>' +
                '<div style="overflow-x:auto;border-radius:8px;border:1px solid rgba(255,255,255,.1);">' +
                '<table style="width:100%;border-collapse:collapse;">' +
                '<thead><tr style="background:rgba(255,255,255,.06);border-bottom:1px solid rgba(255,255,255,.12);">' +
                    '<th style="padding:8px;text-align:center;font-size:.75em;color:#94a3b8;font-weight:600;letter-spacing:.05em;">DEPORTE</th>' +
                    '<th style="padding:8px;text-align:center;font-size:.75em;color:#94a3b8;font-weight:600;letter-spacing:.05em;">LIGA</th>' +
                    '<th style="padding:8px;text-align:left;font-size:.75em;color:#94a3b8;font-weight:600;letter-spacing:.05em;">EQUIPO / SELECCIÓN</th>' +
                    '<th style="padding:8px;text-align:center;font-size:.75em;color:#94a3b8;font-weight:600;letter-spacing:.05em;">LOGRO</th>' +
                    '<th style="padding:8px;text-align:center;font-size:.75em;color:#94a3b8;font-weight:600;letter-spacing:.05em;">CUOTA</th>' +
                    '<th style="padding:8px;text-align:center;font-size:.75em;color:#94a3b8;font-weight:600;letter-spacing:.05em;">MARCADOR</th>' +
                    '<th style="padding:8px;text-align:center;font-size:.75em;color:#94a3b8;font-weight:600;letter-spacing:.05em;">GANÓ</th>' +
                '</tr></thead>' +
                '<tbody>' + detalleRows + '</tbody>' +
                '</table></div>' +
                '</div>';

            Swal.fire({
                title: '<span style="color:#48CAE4;font-size:1.1em;">Detalle Ticket #' + d.ticket + '</span>',
                html: html,
                width: Math.min(820, window.innerWidth * 0.96) + 'px',
                background: '#002E5C',
                color: '#fff',
                showCloseButton: true,
                showConfirmButton: false
            });
        })
        .fail(function() {
            Swal.fire({ icon:'error', title:'Error de conexión', text:'No se pudo comunicar con el servidor.', background:'#002E5C', color:'#fff' });
        });
}

function infoChip(label, value, color) {
    return '<div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:8px;padding:6px 12px;min-width:110px;">' +
        '<div style="font-size:.65em;color:#64748b;letter-spacing:.06em;text-transform:uppercase;margin-bottom:2px;">' + label + '</div>' +
        '<div style="font-size:.92em;font-weight:700;color:' + color + ';">' + value + '</div>' +
        '</div>';
}
</script>
}
