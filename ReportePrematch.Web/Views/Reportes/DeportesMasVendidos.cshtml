@{
    Layout = "_Layout";
}

<style>
    .quick-metrics-bar { display:flex; gap:.5rem; flex-wrap:wrap; }
    .metric-card { flex:1; min-width:120px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:.5rem .75rem; text-align:center; }
    @@media (max-width:768px) { .metric-card { min-width:80px; flex:1 1 80px; padding:.45rem .55rem; } }
    @@media (max-width:430px) { .metric-card { min-width:68px; flex:1 1 68px; padding:.38rem .45rem; } .metric-value { font-size:.88rem; } }
    .metric-label { font-size:.65rem; color:rgba(255,255,255,0.5); letter-spacing:.5px; text-transform:uppercase; margin-bottom:.25rem; }
    .metric-value { font-size:1.05rem; font-weight:700; }
    .metric-blue  { color:#48CAE4; }
    .metric-green { color:#4ade80; }
</style>

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub">Ranking de deportes · Todos los canales</div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <h6 class="text-white mb-2"><i class="ti ti-users"></i> Agrupados por Agente</h6>
        <div id="metricsBar1" class="quick-metrics-bar mb-2" style="display:none;">
            <div class="metric-card"><div class="metric-label">Total Tickets</div><div class="metric-value metric-blue" id="met1Tickets">—</div></div>
            <div class="metric-card"><div class="metric-label">Total Monto</div><div class="metric-value metric-green" id="met1Monto">—</div></div>
        </div>
        <div class="table-responsive">
            <table id="@ViewBag.TableId1" class="glass-table w-100">
                <thead>
                    <tr>
                        <th class="text-center">Agente</th>
                        <th class="text-center">Deporte</th>
                        <th class="text-center">Cant. Tickets</th>
                        <th class="text-center">Monto</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <h6 class="text-white mb-2"><i class="ti ti-ball-football"></i> Agrupados por Deporte</h6>
        <div id="metricsBar2" class="quick-metrics-bar mb-2" style="display:none;">
            <div class="metric-card"><div class="metric-label">Deportes</div><div class="metric-value metric-blue" id="met2Deportes">—</div></div>
            <div class="metric-card"><div class="metric-label">Total Tickets</div><div class="metric-value metric-blue" id="met2Tickets">—</div></div>
            <div class="metric-card"><div class="metric-label">Total Monto</div><div class="metric-value metric-green" id="met2Monto">—</div></div>
        </div>
        <div class="table-responsive">
            <table id="@ViewBag.TableId2" class="glass-table w-100">
                <thead>
                    <tr>
                        <th class="text-center">Deporte</th>
                        <th class="text-center">Cant. Tickets</th>
                        <th class="text-center">Monto</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

</section>

@section Scripts {
<script>
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';

function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgenciasApi","Reportes")')
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, {
                maxOptions: 2000,
                create: false,
                allowEmptyOption: true,
                placeholder: 'Buscar agente...',
                searchField: ['text']
            });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
        })
        .fail(function(xhr) {
            console.error('[Agentes] Error HTTP ' + xhr.status, xhr.responseText);
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes (HTTP ' + xhr.status + ').', background: '#002E5C', color: '#fff' });
        });
}

let dtAgente, dtDeporte;
function fmt(v) { return parseFloat(v || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

function cargarReporte() {
    const fechaD = document.getElementById('fechaD').value;
    const fechaH = document.getElementById('fechaH').value;
    const agente = document.getElementById('agente').value || 'TODOS';
    if (!fechaD || !fechaH) {
        Swal.fire({ icon: 'warning', title: 'Fechas requeridas', background: '#002E5C', color: '#fff' });
        return;
    }
    showBusy('Consultando...');

    const reqAgente  = $.post('@Url.Action("GetDeportesMasVendidosPorAgente","Reportes")',  { fechaD, fechaH, agente });
    const reqDeporte = $.post('@Url.Action("GetDeportesMasVendidosPorDeporte","Reportes")', { fechaD, fechaH, agente });

    $.when(reqAgente, reqDeporte)
        .done(function(resAgente, resDeporte) {
            const dataAgente  = resAgente[0]  || [];
            const dataDeporte = resDeporte[0] || [];

            // ── Métricas Tabla 1 ──
            var tot1T = 0, tot1M = 0;
            dataAgente.forEach(function(r) {
                tot1T += parseInt(r.cantTickets ?? r.CantTickets ?? 0);
                tot1M += parseFloat(r.monto ?? r.Monto ?? 0);
            });
            document.getElementById('met1Tickets').textContent = tot1T.toLocaleString('es-VE');
            document.getElementById('met1Monto').textContent   = fmt(tot1M);
            document.getElementById('metricsBar1').style.display = dataAgente.length ? 'flex' : 'none';

            // ── Tabla 1: por Agente ──
            if (dtAgente) { dtAgente.destroy(); dtAgente = null; }
            dtAgente = $('#@ViewBag.TableId1').DataTable({
                data: dataAgente,
                columns: [
                    { data: null, className: 'text-center', render: function(row) { return row.agente || row.Agente || '—'; } },
                    { data: null, className: 'text-center', render: function(row) { return row.deporte || row.Deporte || '—'; } },
                    { data: null, className: 'text-center', render: function(row) { return row.cantTickets ?? row.CantTickets ?? 0; } },
                    { data: null, className: 'text-center', render: function(row) { return fmt(row.monto ?? row.Monto); }, createdCell: function(td) { $(td).addClass('col-monto-pos'); } }
                ],
                language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
                pageLength: 50,
                order: [[0, 'asc'], [1, 'asc']],
                dom: 'Bfrtip',
                buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm' }]
            });

            // ── Métricas Tabla 2 ──
            var tot2T = 0, tot2M = 0;
            dataDeporte.forEach(function(r) {
                tot2T += parseInt(r.cantTickets ?? r.CantTickets ?? 0);
                tot2M += parseFloat(r.monto ?? r.Monto ?? 0);
            });
            document.getElementById('met2Deportes').textContent = dataDeporte.length.toLocaleString('es-VE');
            document.getElementById('met2Tickets').textContent  = tot2T.toLocaleString('es-VE');
            document.getElementById('met2Monto').textContent    = fmt(tot2M);
            document.getElementById('metricsBar2').style.display = dataDeporte.length ? 'flex' : 'none';

            if (dtDeporte) { dtDeporte.destroy(); dtDeporte = null; }
            dtDeporte = $('#@ViewBag.TableId2').DataTable({
                data: dataDeporte,
                columns: [
                    { data: null, className: 'text-center', render: function(row) { return row.deporte || row.Deporte || '—'; } },
                    { data: null, className: 'text-center', render: function(row) { return row.cantTickets ?? row.CantTickets ?? 0; } },
                    { data: null, className: 'text-center', render: function(row) { return fmt(row.monto ?? row.Monto); }, createdCell: function(td) { $(td).addClass('col-monto-pos'); } }
                ],
                language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
                pageLength: 50,
                order: [[0, 'asc']],
                dom: 'Bfrtip',
                buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm' }]
            });

            hideBusy();
        })
        .fail(function() {
            Swal.fire({ icon: 'error', title: 'Error al consultar', background: '#002E5C', color: '#fff' });
            hideBusy();
        });
}

$(document).ready(function () {
    cargarAgentes();
    if (!esAdmin) { cargarReporte(); }
});
</script>
}
