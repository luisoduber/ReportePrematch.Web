@{
    Layout = "_Layout";
}

<style>
    .agent-block { margin-bottom: 2rem; }
    .agent-block-header {
        display: flex; align-items: center; gap: .6rem;
        font-size: 1rem; font-weight: 700; letter-spacing: .04em;
        color: #48CAE4; margin-bottom: .6rem;
        padding-bottom: .35rem;
        border-bottom: 1px solid rgba(72,202,228,.25);
    }
    .agent-block-header i { font-size: 1.1rem; }

    .quick-metrics-bar { display:flex; gap:.5rem; flex-wrap:wrap; }
    .metric-card { flex:1; min-width:110px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:.5rem .75rem; text-align:center; }
    @@media (max-width:768px) { .metric-card { min-width:80px; flex:1 1 80px; padding:.45rem .55rem; } }
    @@media (max-width:430px) { .metric-card { min-width:68px; flex:1 1 68px; padding:.38rem .45rem; } .metric-value { font-size:.88rem; } }
    .metric-label { font-size:.62rem; color:rgba(255,255,255,0.5); letter-spacing:.5px; text-transform:uppercase; margin-bottom:.25rem; }
    .metric-value { font-size:1rem; font-weight:700; }
    .metric-blue  { color:#48CAE4; }
    .metric-green { color:#4ade80; }

    .section-title {
        font-size:.85rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase;
        color:rgba(255,255,255,.55); margin-bottom:.75rem;
        display:flex; align-items:center; gap:.45rem;
    }
    .section-title i { font-size:1rem; }
</style>

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub">Ranking de deportes · Todos los canales</div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-3">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <!-- Sección 1: Por Agente (bloques dinámicos) -->
    <div class="mt-4">
        <div class="section-title"><i class="ti ti-users"></i> Agrupados por Agente</div>

    <!-- Barra exportacion -->
    <div id="exportBar" class="mt-3 d-none d-flex gap-2 flex-wrap">
        <button class="btn-glass btn-primary" onclick="exportExcel()">
            <i class="ti ti-file-spreadsheet"></i> Excel completo
        </button>
        <button class="btn-glass" style="border-color:rgba(255,100,100,.5);color:#f87171;" onclick="exportPDF()">
            <i class="ti ti-file-type-pdf"></i> PDF por agente
        </button>
    </div>

        <div id="agentBlocks"></div>
    </div>

    <!-- Sección 2: Por Deporte (bloque único) -->
    <div class="mt-4">
        <div class="section-title"><i class="ti ti-ball-football"></i> Agrupados por Deporte</div>
        <div id="metricsBarDeporte" class="quick-metrics-bar mb-2" style="display:none;">
            <div class="metric-card"><div class="metric-label">Deportes</div><div class="metric-value metric-blue" id="metDeportes">—</div></div>
            <div class="metric-card"><div class="metric-label">Total Tickets</div><div class="metric-value metric-blue" id="metTicketsD">—</div></div>
            <div class="metric-card"><div class="metric-label">Total Monto</div><div class="metric-value metric-green" id="metMontoD">—</div></div>
        </div>
        <div class="table-responsive">
            <table id="@ViewBag.TableId2" class="glass-table w-100">
                <thead>
                    <tr>
                        <th class="text-center">Deporte</th>
                        <th class="text-center">Cant. Tickets</th>
                        <th class="text-center">Monto</th>
                    </tr>
                </thead>
                <tbody></tbody>
                <tfoot>
                    <tr>
                        <th class="text-center">TOTAL</th>
                        <th id="totTicketsD" class="text-center"></th>
                        <th id="totMontoD"   class="text-center"></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</section>

@section Scripts {
<script>
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';
let lastData = [];
let dtInstances = [];
let dtDeporte;

function fmt(v) { return parseFloat(v || 0).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
function card(label, value, cls) {
    return '<div class="metric-card">'
        + '<div class="metric-label">' + label + '</div>'
        + '<div class="metric-value ' + cls + '">' + value + '</div>'
        + '</div>';
}

function limpiarAgentes() {
    dtInstances.forEach(function(dt){ try { dt.destroy(); } catch(e){} });
    dtInstances = [];
    document.getElementById('agentBlocks').innerHTML = '';
    lastData = []; document.getElementById('exportBar').classList.add('d-none');
}

/* ── render bloque por agente (Sección 1) ─────────────────────────────── */
function renderBloqueAgente(agente, rows, idx) {
    var totT = 0, totM = 0;
    rows.forEach(function(r) {
        totT += parseInt(r.cantTickets ?? r.CantTickets ?? 0);
        totM += parseFloat(r.monto ?? r.Monto ?? 0);
    });

    var tableId = 'tblDMVAg_' + idx;
    var block = document.createElement('div');
    block.className = 'agent-block';
    block.innerHTML =
        '<div class="agent-block-header"><i class="ti ti-user"></i>' + agente + '</div>' +
        '<div class="quick-metrics-bar mb-2">' +
            card('Total Tickets', totT.toLocaleString('es-VE'), 'metric-blue') +
            card('Total Monto',   fmt(totM),                    'metric-green') +
        '</div>' +
        '<div class="table-responsive">' +
        '<table id="' + tableId + '" class="glass-table w-100">' +
        '<thead><tr>' +
            '<th class="text-center">Deporte</th>' +
            '<th class="text-center">Cant. Tickets</th>' +
            '<th class="text-center">Monto</th>' +
        '</tr></thead><tbody></tbody>' +
        '<tfoot><tr>' +
            '<th class="text-center">TOTAL</th>' +
            '<th class="text-center">' + totT.toLocaleString('es-VE') + '</th>' +
            '<th class="text-center col-monto-pos">' + fmt(totM) + '</th>' +
        '</tr></tfoot>' +
        '</table></div>';

    document.getElementById('agentBlocks').appendChild(block);

    var dt = $('#' + tableId).DataTable({
        data: rows,
        columns: [
            { data: null, className: 'text-center', render: function(r){ return r.deporte || r.Deporte || '—'; } },
            { data: null, className: 'text-center', render: function(r){ return (r.cantTickets ?? r.CantTickets ?? 0).toLocaleString('es-VE'); } },
            { data: null, className: 'text-center col-monto-pos', render: function(r){ return fmt(r.monto ?? r.Monto); } }
        ],
        language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
        pageLength: 100, lengthMenu: [[100, 500, 1000, -1], ['100', '500', '1000', 'Todos']], order: [[0, 'asc']], dom: 'Bfrt<"d-flex justify-content-end align-items-center mt-2"l>',
        buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm', title: agente }]
    });

    dtInstances.push(dt);
}

/* ── agentes ──────────────────────────────────────────────────────────── */
function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgenciasApi","Reportes")')
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, { maxOptions: 2000, create: false, allowEmptyOption: true, placeholder: 'Buscar agente...', searchField: ['text'] });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
        })
        .fail(function(xhr) {
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes (HTTP ' + xhr.status + ').', background: '#002E5C', color: '#fff' });
        });
}

/* ── carga principal ──────────────────────────────────────────────────── */
function cargarReporte() {
    const fechaD = document.getElementById('fechaD').value;
    const fechaH = document.getElementById('fechaH').value;
    const agente = document.getElementById('agente').value || 'TODOS';
    if (!fechaD || !fechaH) {
        Swal.fire({ icon: 'warning', title: 'Fechas requeridas', background: '#002E5C', color: '#fff' });
        return;
    }
    limpiarAgentes();
    showBusy('Consultando...');

    const reqAgente  = $.post('@Url.Action("GetDeportesMasVendidosPorAgente","Reportes")',  { fechaD, fechaH, agente });
    const reqDeporte = $.post('@Url.Action("GetDeportesMasVendidosPorDeporte","Reportes")', { fechaD, fechaH, agente });

    $.when(reqAgente, reqDeporte)
        .done(function(resAgente, resDeporte) {
            hideBusy();
            const dataAgente  = resAgente[0]  || [];
            const dataDeporte = resDeporte[0] || [];

            /* ── Sección 1: bloques por agente ── */
            if (dataAgente.length) {
                var grupos = {};
                var orden  = [];
                dataAgente.forEach(function(r) {
                    var ag = r.agente || r.Agente || '(Sin Agente)';
                    if (!grupos[ag]) { grupos[ag] = []; orden.push(ag); }
                    grupos[ag].push(r);
                });
                orden.forEach(function(ag, idx) { renderBloqueAgente(ag, grupos[ag], idx); });
                lastData = dataAgente; document.getElementById('exportBar').classList.remove('d-none');
            }

            /* ── Sección 2: DataTable global por deporte ── */
            var tot2T = 0, tot2M = 0;
            dataDeporte.forEach(function(r) {
                tot2T += parseInt(r.cantTickets ?? r.CantTickets ?? 0);
                tot2M += parseFloat(r.monto ?? r.Monto ?? 0);
            });
            document.getElementById('metDeportes').textContent  = dataDeporte.length.toLocaleString('es-VE');
            document.getElementById('metTicketsD').textContent  = tot2T.toLocaleString('es-VE');
            document.getElementById('metMontoD').textContent    = fmt(tot2M);
            document.getElementById('metricsBarDeporte').style.display = dataDeporte.length ? 'flex' : 'none';

            if (dtDeporte) { dtDeporte.destroy(); dtDeporte = null; }
            dtDeporte = $('#@ViewBag.TableId2').DataTable({
                data: dataDeporte,
                columns: [
                    { data: null, className: 'text-center', render: function(r){ return r.deporte || r.Deporte || '—'; } },
                    { data: null, className: 'text-center', render: function(r){ return (r.cantTickets ?? r.CantTickets ?? 0).toLocaleString('es-VE'); } },
                    { data: null, className: 'text-center col-monto-pos', render: function(r){ return fmt(r.monto ?? r.Monto); } }
                ],
                footerCallback: function() {
                    document.getElementById('totTicketsD').textContent = tot2T.toLocaleString('es-VE');
                    document.getElementById('totMontoD').textContent   = fmt(tot2M);
                },
                language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
                pageLength: 100, lengthMenu: [[100, 500, 1000, -1], ['100', '500', '1000', 'Todos']], order: [[0, 'asc']], dom: 'Bfrt<"d-flex justify-content-end align-items-center mt-2"l>',
                buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm' }]
            });
        })
        .fail(function() {
            hideBusy();
            Swal.fire({ icon: 'error', title: 'Error al consultar', background: '#002E5C', color: '#fff' });
        });
}


/* -- Exportacion -------------------------------------------------- */
var EXPORT_CONFIG = {
    reportName: 'Deportes Mas Vendidos',
    groupField: function(r){ return r.agente || r.Agente || '(Sin Agente)'; },
    cols: [
        { head: 'Agente',       get: function(r){ return r.agente || r.Agente || '(Sin Agente)'; }, type: 'text' },
        { head: 'Deporte',      get: function(r){ return r.deporte || r.Deporte || '--'; },          type: 'text' },
        { head: 'Cant Tickets', get: function(r){ return parseInt(r.cantTickets ?? r.CantTickets ?? 0); }, type: 'int' },
        { head: 'Monto',        get: function(r){ return parseFloat(r.monto ?? r.Monto ?? 0); },     type: 'money' }
    ]
};
function exportExcel() { ExportHelpers.exportarExcel(lastData, EXPORT_CONFIG); }
function exportPDF() {
    ExportHelpers.exportarPDF(lastData, EXPORT_CONFIG, document.getElementById('fechaD').value, document.getElementById('fechaH').value);
}
$(document).ready(function() {
    cargarAgentes();
    if (!esAdmin) { cargarReporte(); }
});
</script>
}
