@{
    Layout = "_Layout";
}
@* Casino · Bingo Maya — consume Reportes/GetBingMay → api/Casino/ListBingMay *@

<style>
.agent-block { margin-bottom: 2rem; }
.agent-block-header {
    display: flex; align-items: center; gap: .6rem;
    font-size: 1rem; font-weight: 700; letter-spacing: .04em;
    color: #48CAE4; margin-bottom: .6rem;
    padding-bottom: .35rem;
    border-bottom: 1px solid rgba(72,202,228,.25);
}
.agent-block-header i { font-size: 1.1rem; }

.quick-metrics-bar { display:flex; gap:.5rem; flex-wrap:wrap; }
.metric-card { flex:1; min-width:110px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:.5rem .75rem; text-align:center; }
@@media (max-width:768px) { .metric-card { min-width:80px; flex:1 1 80px; padding:.45rem .55rem; } }
@@media (max-width:430px) { .metric-card { min-width:68px; flex:1 1 68px; padding:.38rem .45rem; } .metric-value { font-size:.88rem; } }
.metric-label { font-size:.62rem; color:rgba(255,255,255,0.5); letter-spacing:.5px; text-transform:uppercase; margin-bottom:.25rem; }
.metric-value { font-size:1rem; font-weight:700; }
.metric-blue   { color:#48CAE4; }
.metric-red    { color:#f87171; }
.metric-green  { color:#4ade80; }
.metric-yellow { color:#fbbf24; }

#globalCards { display:flex; gap:.6rem; flex-wrap:wrap; margin-bottom:1.25rem; }
#globalCards .metric-card { min-width:140px; padding:.65rem 1rem; }
#globalCards .metric-value { font-size:1.05rem; }
</style>

<section class="glass-card">
    <div class="welcome-bar">
        <div>
            <div class="welcome-title">@ViewBag.NombrePagina</div>
            <div class="welcome-sub">Casino · Bingo Maya por Agente</div>
        </div>
        <button class="btn-glass btn-primary" onclick="cargarReporte()">
            <i class="ti ti-refresh"></i> Actualizar
        </button>
    </div>

    <div class="glass-panel mt-3 p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="field-label">Fecha Desde</label>
                <input type="date" id="fechaD" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="field-label">Fecha Hasta</label>
                <input type="date" id="fechaH" class="glass-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="field-label">Agente</label>
                @if (ViewBag.TipoUsuario == "Usuario Regular")
                {
                    <input type="text" id="agente" class="glass-input" value="@ViewBag.Agente" readonly />
                }
                else
                {
                    <select id="agente" class="glass-input" style="color:#fff;">
                        <option value="" style="background:#002E5C;color:#fff;">TODOS</option>
                    </select>
                }
            </div>
            <div class="col-md-2">
                <button class="btn-glass btn-primary w-100" onclick="cargarReporte()">
                    <i class="ti ti-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>

    <!-- Cards globales -->
    <div id="globalCards" class="mt-3 d-none"></div>

    <!-- Barra exportacion -->
    <div id="exportBar" class="mt-2 d-none d-flex gap-2 flex-wrap">
        <button class="btn-glass btn-primary" onclick="exportExcel()">
            <i class="ti ti-file-spreadsheet"></i> Excel completo
        </button>
        <button class="btn-glass" style="border-color:rgba(255,100,100,.5);color:#f87171;" onclick="exportPDF()">
            <i class="ti ti-file-type-pdf"></i> PDF por agente
        </button>
    </div>

    <!-- Bloques por agente -->
    <div id="agentBlocks" class="mt-3"></div>
</section>

@section Scripts {
<script>
const esAdmin       = '@ViewBag.TipoUsuario' !== 'Usuario Regular';
const agenteSession = '@ViewBag.Agente';
let lastData    = [];
let dtInstances = [];

/* ── helpers ──────────────────────────────────────────────────────────── */
function num(v) {
    if (v === null || v === undefined || v === '') return 0;
    if (typeof v === 'number') return v;
    var s = String(v).trim();
    if (s.indexOf(',') >= 0) s = s.replace(/\./g, '').replace(',', '.');
    var n = parseFloat(s);
    return isNaN(n) ? 0 : n;
}
function fmt(v) {
    return num(v).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function card(label, value, cls) {
    return '<div class="metric-card">'
        + '<div class="metric-label">' + label + '</div>'
        + '<div class="metric-value ' + cls + '">' + value + '</div>'
        + '</div>';
}

/* ── accesores de campo (JSON de api/Casino/ListBingMay) ──────────────── */
function fAg(r)    { return r.agente        || r.Agente        || '(Sin Agente)'; }
function fUser(r)  { return r.usuario       || r.Usuario       || '—'; }
function fPlayer(r){ return r.playerId      || r.PlayerId      || '—'; }
function fApost(r) { return num(r.totalApostado ?? r.TotalApostado); }
function fPrem(r)  { return num(r.totalPremiado ?? r.TotalPremiado); }
function fGgrUs(r) { return num(r.ggR_Usuario   ?? r.GGR_Usuario ?? r.ggrUsuario); }
function fGgrAg(r) { return num(r.ggR_Agente    ?? r.GGR_Agente  ?? r.ggrAgente); }

function limpiarBloques() {
    dtInstances.forEach(function(dt){ try { dt.destroy(); } catch(e){} });
    dtInstances = [];
    document.getElementById('agentBlocks').innerHTML = '';
    document.getElementById('globalCards').innerHTML = '';
    document.getElementById('globalCards').classList.add('d-none');
    lastData = [];
    document.getElementById('exportBar').classList.add('d-none');
}

/* ── cards globales (todos los agentes de la consulta) ───────────────── */
function renderGlobalCards(data) {
    var totA = 0, totP = 0, totG = 0, usuarios = 0;
    data.forEach(function(r) { totA += fApost(r); totP += fPrem(r); totG += fGgrUs(r); usuarios++; });
    var el = document.getElementById('globalCards');
    el.innerHTML =
          card('Total Apostado', fmt(totA), 'metric-blue')
        + card('Total Premiado', fmt(totP), 'metric-red')
        + card('GGR General',    fmt(totG), totG >= 0 ? 'metric-green' : 'metric-red')
        + card('Usuarios',       usuarios.toLocaleString('es-VE'), 'metric-yellow');
    el.classList.remove('d-none');
}

/* ── render bloque por agente ─────────────────────────────────────────── */
function renderBloqueAgente(agente, rows, idx) {
    var totA = 0, totP = 0, totG = 0;
    rows.forEach(function(r) { totA += fApost(r); totP += fPrem(r); totG += fGgrUs(r); });

    var tableId = 'tblBingMay_' + idx;
    var block = document.createElement('div');
    block.className = 'agent-block';
    block.innerHTML =
        '<div class="agent-block-header"><i class="ti ti-user"></i>' + agente + '</div>' +
        '<div class="quick-metrics-bar mb-2">' +
            card('Total Apostado', fmt(totA), 'metric-blue') +
            card('Total Premiado', fmt(totP), 'metric-red')  +
            card('GGR Agente',     fmt(totG), totG >= 0 ? 'metric-green' : 'metric-red') +
            card('Usuarios',       rows.length.toLocaleString('es-VE'), 'metric-yellow') +
        '</div>' +
        '<div class="table-responsive">' +
        '<table id="' + tableId + '" class="glass-table w-100">' +
        '<thead><tr>' +
            '<th style="text-align:center;">Usuario</th>' +
            '<th style="text-align:center;">Player ID</th>' +
            '<th style="text-align:center;">Total Apostado</th>' +
            '<th style="text-align:center;">Total Premiado</th>' +
            '<th style="text-align:center;">GGR Usuario</th>' +
        '</tr></thead><tbody></tbody>' +
        '<tfoot><tr>' +
            '<th colspan="2" style="text-align:center;">TOTAL</th>' +
            '<th style="text-align:center;">' + fmt(totA) + '</th>' +
            '<th style="text-align:center;">' + fmt(totP) + '</th>' +
            '<th style="text-align:center;color:' + (totG >= 0 ? 'var(--av-5,#7FCA8A)' : '#FC8181') + ';font-weight:600;">' + fmt(totG) + '</th>' +
        '</tr></tfoot>' +
        '</table></div>';

    document.getElementById('agentBlocks').appendChild(block);

    var dt = $('#' + tableId).DataTable({
        data: rows,
        columns: [
            { data: null, className: 'text-center', render: function(d,t,r){ return fUser(r); } },
            { data: null, className: 'text-center', render: function(d,t,r){ return fPlayer(r); } },
            { data: null, className: 'text-center col-monto-pos',
              render: function(d,t,r){ return t === 'display' ? fmt(fApost(r)) : fApost(r); } },
            { data: null, className: 'text-center col-monto-neg',
              render: function(d,t,r){ return t === 'display' ? fmt(fPrem(r)) : fPrem(r); } },
            { data: null, className: 'text-center',
              render: function(d,t,r){ return t === 'display' ? fmt(fGgrUs(r)) : fGgrUs(r); },
              createdCell: function(td,_d,r){ $(td).addClass(fGgrUs(r) < 0 ? 'col-monto-neg' : 'col-monto-pos'); } }
        ],
        language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json' },
        pageLength: 100, lengthMenu: [[100, 500, 1000, -1], ['100', '500', '1000', 'Todos']],
        order: [[0, 'asc']],
        dom: 'Bfrt<"d-flex justify-content-end align-items-center mt-2"l>',
        buttons: [{ extend: 'excelHtml5', text: '<i class="ti ti-file-spreadsheet"></i> Excel', className: 'btn-glass btn-primary btn-sm', title: agente }]
    });

    dtInstances.push(dt);
}

/* ── agentes ──────────────────────────────────────────────────────────── */
function cargarAgentes() {
    if (!esAdmin) return;
    $.post('@Url.Action("GetListAgentFilt","Reportes")')
        .done(function(lista) {
            const sel = document.getElementById('agente');
            if (!sel) return;
            if (sel.tomselect) sel.tomselect.destroy();
            sel.innerHTML = '';
            const optTodos = document.createElement('option');
            optTodos.value = ''; optTodos.textContent = 'TODOS';
            sel.appendChild(optTodos);
            (lista || []).forEach(function(a) {
                const opt = document.createElement('option');
                opt.value = a; opt.textContent = a;
                sel.appendChild(opt);
            });
            new TomSelect(sel, { maxOptions: 2000, create: false, allowEmptyOption: true, placeholder: 'Buscar agente...', searchField: ['text'] });
            if (agenteSession) sel.tomselect.setValue(agenteSession, true);
        })
        .fail(function(xhr) {
            Swal.fire({ icon: 'warning', title: 'Aviso', text: 'No se pudo cargar la lista de agentes (HTTP ' + xhr.status + ').', background: '#002E5C', color: '#fff' });
        });
}

/* ── carga principal ──────────────────────────────────────────────────── */
function cargarReporte() {
    const fechaD   = document.getElementById('fechaD').value;
    const fechaH   = document.getElementById('fechaH').value;
    const agenteEl = document.getElementById('agente');
    const agente   = agenteEl ? (agenteEl.tomselect ? agenteEl.tomselect.getValue() : agenteEl.value) : agenteSession;

    if (!fechaD || !fechaH) {
        Swal.fire({ icon: 'warning', title: 'Fechas requeridas', background: '#002E5C', color: '#fff' });
        return;
    }

    limpiarBloques();
    showBusy('Consultando Bingo Maya...');

    $.post('@Url.Action("GetBingMay","Reportes")', { fechaD, fechaH, agente })
        .done(function(data) {
            hideBusy();
            if (!data || !data.length) {
                Swal.fire({ icon: 'info', title: 'Sin resultados', background: '#002E5C', color: '#fff' });
                return;
            }

            renderGlobalCards(data);

            // Agrupar por agente
            var grupos = {}, orden = [];
            data.forEach(function(r) {
                var ag = fAg(r);
                if (!grupos[ag]) { grupos[ag] = []; orden.push(ag); }
                grupos[ag].push(r);
            });
            orden.forEach(function(ag, idx) { renderBloqueAgente(ag, grupos[ag], idx); });

            lastData = data;
            document.getElementById('exportBar').classList.remove('d-none');
        })
        .fail(function(xhr) {
            hideBusy();
            var msg = 'No se pudo cargar el reporte (HTTP ' + xhr.status + ').';
            try { var resp = JSON.parse(xhr.responseText); if (resp && resp.error) msg = resp.error; } catch(e){}
            Swal.fire({ icon: xhr.status === 504 ? 'warning' : 'error', title: xhr.status === 504 ? 'Tiempo de espera agotado' : 'Error', text: msg, background: '#002E5C', color: '#fff' });
        });
}

/* ── exportación (Excel / PDF por agente) ─────────────────────────────── */
var EXPORT_CONFIG = {
    reportName: 'Bingo Maya',
    groupField: function(r){ return fAg(r); },
    cols: [
        { head: 'Agente',         get: function(r){ return fAg(r); },     type: 'text'  },
        { head: 'Usuario',        get: function(r){ return fUser(r); },   type: 'text'  },
        { head: 'Player ID',      get: function(r){ return fPlayer(r); }, type: 'text'  },
        { head: 'Total Apostado', get: function(r){ return fApost(r); },  type: 'money' },
        { head: 'Total Premiado', get: function(r){ return fPrem(r); },   type: 'money' },
        { head: 'GGR Usuario',    get: function(r){ return fGgrUs(r); },  type: 'money' }
    ]
};
function exportExcel() { ExportHelpers.exportarExcel(lastData, EXPORT_CONFIG); }
function exportPDF() {
    ExportHelpers.exportarPDF(lastData, EXPORT_CONFIG,
        document.getElementById('fechaD').value, document.getElementById('fechaH').value);
}

$(document).ready(function() {
    cargarAgentes();
    if (!esAdmin) { cargarReporte(); }
});
</script>
}
